# Cloudflare Pages headers — copied verbatim into the deploy from /public.
# https://developers.cloudflare.com/pages/configuration/headers/

# Security headers + AI-training opt-out. X-Robots-Tag noai/noimageai
# (DeviantArt convention, honored by img2dataset et al.) and tdm-reservation
# (TDM Reservation Protocol, Art. 4(3) EU 2019/790 — see /legal and
# /.well-known/tdmrep.json) apply to every response, images included. Unknown
# X-Robots-Tag tokens are ignored by search engines, so indexing is unaffected.
#
# img-src allows blob: because the project pages admit each animated-WebP
# turnaround as a freshly created object URL — that is what starts its loop
# at frame 1, and so lets a set of them spin in phase. Without it they fall
# back to loading from their own URLs and the sync degrades to the old drift.
#
# Permissions-Policy lists ONLY features nothing here uses. Every feature the
# YouTube embed declares in its `allow` attribute — autoplay, accelerometer,
# gyroscope, picture-in-picture, encrypted-media, web-share, fullscreen — is
# deliberately absent, because a document-level denial overrides what an iframe
# may be granted and would disable it inside the player with no error. Same for
# clipboard-write, which the About card's "Copy email" button uses, and autoplay,
# which the gallery's muted looping clips need.
#
# script-src keeps 'unsafe-inline' because Astro inlines every component script
# into the page (30 of them across the site) rather than emitting /_astro/*.js.
# Hashing them would mean ~30 sha256 values on this one physical line, rewritten
# on every build. The exposure it would buy back is small here: no page takes
# user input, renders a query parameter, or loads third-party script.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-Permitted-Cross-Domain-Policies: none
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), serial=(), bluetooth=(), midi=(), hid=(), display-capture=(), idle-detection=(), local-fonts=(), screen-wake-lock=(), xr-spatial-tracking=(), browsing-topics=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; worker-src 'none'; frame-ancestors 'none'; frame-src https://www.youtube-nocookie.com; img-src 'self' data: blob:; media-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self' 'unsafe-inline'; connect-src 'self'; form-action 'self'
  X-Robots-Tag: noai, noimageai
  tdm-reservation: 1

# Self-hosted font files never change under the same filename.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Brand rasters at the site root: stable filenames, rarely replaced, and
# previously matched by no rule at all — so they were revalidated on every
# single page load.
/og.jpg
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/favicon.ico
  Cache-Control: public, max-age=604800

# Content media is NOT content-hashed (a replaced photo keeps its filename —
# see gen-responsive.mjs), so no `immutable` here: one day of caching, then
# revalidate. A swapped image can be stale for at most a day.
#
# These are scoped BY EXTENSION on purpose. A bare `/productions/*` also
# matches the HTML pages living under the same prefix, which cached project
# and collection pages for 24h — so a published fix could stay invisible to a
# returning visitor for a day, and the Ctrl+F5 in UPDATING.md is precisely
# what hides that from the person doing the checking. HTML now falls through
# to Cloudflare's default (max-age=0, must-revalidate).
/photography/*.jpg
  Cache-Control: public, max-age=86400
/photography/*.webp
  Cache-Control: public, max-age=86400
/productions/*.jpg
  Cache-Control: public, max-age=86400
/productions/*.webp
  Cache-Control: public, max-age=86400
/productions/*.mp4
  Cache-Control: public, max-age=86400
/productions/*.webm
  Cache-Control: public, max-age=86400
/about/*.webp
  Cache-Control: public, max-age=86400
