---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { SITE, SOCIAL } from "../consts";

interface Props {
  title?: string;
  description?: string;
  /** OG image path under /public, e.g. "/og.jpg". Falls back to the site default. */
  image?: string;
  /** Omit footer (used on full-bleed pages) */
  noFooter?: boolean;
  /** Omit nav (used on full-screen gateway pages that supply their own navigation) */
  noNav?: boolean;
}

const { title, description = SITE.description, image = "/og.jpg", noFooter, noNav } = Astro.props;

const pageTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — ${SITE.role}`;
const origin = Astro.site ?? Astro.url.origin;
const canonical = new URL(Astro.url.pathname, origin);
const ogImage = new URL(image, origin);

// Structured data — a single Person entity for the whole site, so search
// engines can attach the name, role, location and profiles to Alexandre.
const personLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: SITE.name,
  jobTitle: SITE.role,
  email: SITE.email,
  url: origin.toString(),
  image: ogImage.toString(),
  address: { "@type": "PostalAddress", addressLocality: SITE.location.split("·")[0].trim() },
  sameAs: SOCIAL.filter((s) => s.href.startsWith("http")).map((s) => s.href),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#FAFAF8" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Preload the three above-the-fold fonts (display headings, body, nav
         labels) so they don't wait on the CSS to be parsed first. The other
         weights load on demand via @font-face as usual. -->
    <link rel="preload" href="/fonts/bodoni-moda-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jost-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jost-500-latin.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(personLd)} />
  </head>
  <body class="flex min-h-[100dvh] flex-col bg-paper text-ink antialiased">
    <a href="#main" class="skip-link">Skip to content</a>
    {!noNav && <Nav />}
    <main id="main" class="flex-1">
      <slot />
    </main>
    {!noFooter && <Footer />}
  </body>
</html>
