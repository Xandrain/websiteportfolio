---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import ContactFab from "../components/ContactFab.astro";
import { SITE, SOCIAL } from "../consts";
import { dims } from "../lib/responsive";
import { abs, personId, personRef } from "../lib/schema";

interface Props {
  title?: string;
  description?: string;
  /** OG image path under /public, e.g. "/og.jpg". Falls back to the site default. */
  image?: string;
  /** Omit footer (used on full-bleed pages) */
  noFooter?: boolean;
  /** Omit nav (used on full-screen gateway pages that supply their own navigation) */
  noNav?: boolean;
  /** Extra JSON-LD nodes merged into the page's @graph (see src/lib/schema.ts) */
  schema?: Record<string, unknown>[];
}

const {
  title,
  description = SITE.description,
  image = "/og.jpg",
  noFooter,
  noNav,
  schema = [],
} = Astro.props;

const pageTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — ${SITE.role}`;
const origin = Astro.site ?? Astro.url.origin;
const canonical = new URL(Astro.url.pathname, origin);
const ogImage = new URL(image, origin);
// Content covers are in the generated dims map; the default /og.jpg is a
// fixed 1200×630 produced by scripts/gen-brand-assets.mjs.
const ogDims = dims(image) ?? { w: 1200, h: 630 };

// Which shape the identity morph is landing on. The card lives only on the
// gate; every other page carries the nav pill instead. The view-transition
// pseudo-elements belong to the INCOMING document, so this attribute is how
// the arriving page tells global.css which way to run the shape — pill to
// card here, card to pill everywhere else. Without it the radius travels the
// same way in both directions and the card arrives as a stadium.
const isGate = Astro.url.pathname === "/";

// Floating "Contact" pill (→ /about) on the two work sections only.
const showContactFab = ["/photography", "/productions"].some((p) =>
  Astro.url.pathname.startsWith(p),
);

// Structured data — one @graph per page: the site-wide WebSite + Person
// entities (stable @ids, so search engines merge every page's signals into a
// single "Alexandre Haineaux" entity) plus any page-specific nodes passed via
// the `schema` prop (breadcrumbs, galleries, artworks — see src/lib/schema.ts).
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": abs(origin, "/#website"),
      url: origin.toString(),
      name: SITE.name,
      description: SITE.description,
      inLanguage: "en",
      publisher: personRef(origin),
    },
    {
      "@type": "Person",
      "@id": personId(origin),
      name: SITE.name,
      jobTitle: SITE.role,
      description: SITE.description,
      email: SITE.email,
      url: origin.toString(),
      image: abs(origin, "/about/avatar.webp"),
      address: {
        "@type": "PostalAddress",
        addressLocality: SITE.location.split("·")[0].trim(),
        addressCountry: "LU",
      },
      knowsAbout: [
        "Photography",
        "Graphic design",
        "3D modelling",
        "Character rigging",
        "Product visualisation",
      ],
      sameAs: SOCIAL.filter((s) => s.href.startsWith("http")).map((s) => s.href),
    },
    ...schema,
  ],
};
---

<!doctype html>
<html lang="en" data-gate={isGate ? "" : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <!-- max-image-preview:large lets Google show full-size image previews;
         noai/noimageai are AI-training opt-out tokens (ignored by search engines) -->
    <meta name="robots" content="index, follow, max-image-preview:large, noai, noimageai" />
    <meta name="theme-color" content="#FAFAF8" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(ogDims.w)} />
    <meta property="og:image:height" content={String(ogDims.h)} />
    <meta property="og:image:alt" content={pageTitle} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={pageTitle} />

    <!-- Preload the three above-the-fold fonts (display headings, body, nav
         labels) so they don't wait on the CSS to be parsed first. The other
         weights load on demand via @font-face as usual. -->
    <link rel="preload" href="/fonts/bodoni-moda-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jost-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jost-500-latin.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>
  <!-- The column shell (fills the viewport, footer pinned) is on `body` and
       `body > main` in global.css — it was five utility classes here. -->
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    {!noNav && <Nav />}
    <main id="main">
      <slot />
    </main>
    {!noFooter && <Footer />}
    {showContactFab && <ContactFab />}
  </body>
</html>
