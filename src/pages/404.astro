---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTA from "../components/CTA.astro";
---

<BaseLayout title="Page not found" description="The page you were looking for has moved or never existed.">
  <section
    class="mx-auto flex min-h-[70dvh] w-full max-w-editorial flex-col items-center justify-center px-6 text-center"
  >
    <p class="eyebrow mb-7">Error 404</p>
    <h1 class="font-display text-6xl leading-[0.95] tracking-tight text-ink sm:text-8xl">
      Page not found
    </h1>
    <p class="mt-6 max-w-sm text-ink-muted">
      The page you were looking for has moved or never existed.
    </p>
    <div class="mt-10">
      <CTA href="/" label="Return home" icon="→" />
    </div>
  </section>
</BaseLayout>
