---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTA from "../components/CTA.astro";
---

<BaseLayout title="Page not found" description="The page you were looking for has moved or never existed.">
  <section class="notfound editorial">
    <p class="eyebrow notfound__kicker">Error 404</p>
    <h1 class="notfound__title">Page not found</h1>
    <p class="notfound__body">
      The page you were looking for has moved or never existed.
    </p>
    <div class="notfound__cta">
      <CTA href="/" label="Return home" icon="→" />
    </div>
  </section>
</BaseLayout>

<style>
  /* Horizontal geometry comes from .editorial in global.css; only the
     centring and vertical rhythm are this page's own. */
  .notfound {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 70dvh;
    text-align: center;
  }

  .notfound__kicker { margin-bottom: 1.75rem; }

  .notfound__title {
    font-family: var(--font-display);
    font-size: 3.75rem;
    line-height: 0.95;
    letter-spacing: -0.025em;
    color: var(--color-ink);
  }

  @media (min-width: 640px) {
    .notfound__title { font-size: 6rem; }
  }

  .notfound__body {
    margin-top: 1.5rem;
    max-width: 24rem;
    color: var(--color-ink-muted);
  }

  .notfound__cta { margin-top: 2.5rem; }
</style>
