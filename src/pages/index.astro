---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE, NAV } from "../consts";
import { collections } from "../data/photography";
import { projects } from "../data/three-d";
import { srcset, dims } from "../lib/responsive";

// Primary routes (the traffic split) vs. secondary. Driven by consts.
const primary = NAV.filter((i) => i.href !== "/about");
const about = NAV.find((i) => i.href === "/about");

// Curated highlight reel below the gate — a 1-2-1-2 editorial rhythm
// (full-width row, two-up pair, repeated) mixing both disciplines. Each tile
// links to its collection/project page; covers come from the data files so a
// swapped cover updates here too. `full` marks the wide rows; `pos` nudges
// object-position when the wide crop needs reframing.
const photo = (slug: string) => {
  const c = collections.find((c) => c.slug === slug);
  if (!c) throw new Error(`Home featured: unknown collection "${slug}"`);
  return { href: `/photography/${slug}`, src: c.cover, label: c.title };
};
const production = (slug: string) => {
  const p = projects.find((p) => p.slug === slug);
  if (!p) throw new Error(`Home featured: unknown production "${slug}"`);
  return { href: `/productions/${slug}`, src: p.cover, label: p.title };
};

const featured: {
  href: string;
  src: string;
  label: string;
  full?: boolean;
  pos?: string;
}[] = [
  { ...photo("northern-light"), full: true },
  { ...production("mojo-swoptops") },
  { ...photo("in-the-studio") },
  { ...production("crown-reinterpretation"), full: true, pos: "50% 62%" },
  { ...production("half-moon-eau-de-parfum") },
  { ...photo("concrete-and-glass") },
];
---

<BaseLayout
  description={SITE.description}
  noNav
  noFooter
>
  <section class="gate">
    <div class="gate__aura" aria-hidden="true"></div>
    <div class="gate__inner">
      <p class="gate__role">{SITE.role}</p>

      <h1 class="gate__brand">
        {SITE.name}
      </h1>

      <nav class="gate__routes" aria-label="Enter the portfolio">
        {primary.map((item) => (
          <a href={item.href} class="gate__route">
            <span class="gate__route-label">{item.label}</span>
          </a>
        ))}
      </nav>

      {about && (
        <a href={about.href} class="gate__about">
          {about.label}
        </a>
      )}
    </div>

    <a href="#work" class="gate__scroll">
      <span class="gate__scroll-label">Scroll</span>
      <span class="gate__scroll-line" aria-hidden="true"></span>
    </a>
  </section>

  <section id="work" class="work">
    <h2 class="sr-only">Selected work</h2>
    <div class="work__grid">
      {featured.map((f) => {
        const d = dims(f.src);
        return (
          <a
            href={f.href}
            class:list={["work__item", { "work__item--full": f.full }]}
          >
            <img
              src={f.src}
              srcset={srcset(f.src)}
              sizes={f.full ? "100vw" : "50vw"}
              alt={f.label}
              width={d?.w ?? 1600}
              height={d?.h ?? 1067}
              loading="lazy"
              decoding="async"
              class="work__img"
              style={f.pos ? `object-position: ${f.pos}` : undefined}
            />
          </a>
        );
      })}
    </div>
  </section>
</BaseLayout>

<style>
  .gate {
    position: relative;
    overflow: hidden;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6rem 1.5rem;

    /* Discreet complementary wash — a soft warm peach in one corner and its
       cool periwinkle complement in the other, kept very pale so it reads as
       a faint tint rather than colour. A gentle bloom lifts the centre. */
    background:
      radial-gradient(
        56% 48% at 50% 30%,
        rgba(255, 255, 255, 0.5) 0%,
        rgba(255, 255, 255, 0) 58%
      ),
      linear-gradient(
        155deg,
        #F4DFCD 0%,   /* warm — soft peach */
        #F5F2EC 50%,  /* light neutral middle */
        #D2E0F1 100%  /* cool — soft periwinkle (its complement) */
      );
  }

  /* Soft bright aura tracking the cursor (position + opacity set from JS). */
  .gate__aura {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(
      circle 360px at var(--mx, 50%) var(--my, 32%),
      rgba(255, 255, 255, 0.35) 0%,
      rgba(255, 255, 255, 0) 62%
    );
    opacity: var(--aura, 0);
    transition: opacity 0.4s ease;
  }

  .gate__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .gate__aura { transition: none; }
  }

  /* ── Role eyebrow ──────────────────────────────────────────── */
  .gate__role {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
    margin-bottom: 1.5rem;
  }

  /* ── Wordmark — oversized statement type ───────────────────── */
  .gate__brand {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.75rem, 9vw, 7rem);
    line-height: 0.98;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }

  /* ── Primary routes — a segmented pill echoing the site nav ─── */
  /* align-self: stretch makes the bar fill .gate__inner, whose width is
     set by its widest child (the wordmark) — so the bar matches the name. */
  .gate__routes {
    align-self: stretch;
    margin-top: 2.75rem;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    border-radius: 1.75rem;
    background: rgba(250, 250, 248, 0.80);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow:
      0 1px 2px rgba(26, 25, 23, 0.06),
      inset 0 0 0 1px rgba(26, 25, 23, 0.09);
    overflow: hidden;
  }

  .gate__route {
    flex: 1 1 0;
    min-width: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 1.25rem;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-align: center;
    color: var(--color-ink-soft);
    text-decoration: none;
    touch-action: manipulation;
    transition: color 0.25s, background 0.3s;
  }

  /* Hairline divider between the two segments (crisp under the rounded clip).
     Stacked on mobile → horizontal rule; side-by-side on desktop → vertical. */
  .gate__route + .gate__route {
    box-shadow: inset 0 1px 0 rgba(26, 25, 23, 0.09);
  }

  .gate__route:hover,
  .gate__route:focus-visible {
    color: var(--color-accent-ink);
    background: var(--color-accent-wash);
  }

  /* ── Secondary — About ─────────────────────────────────────── */
  .gate__about {
    position: relative;
    margin-top: 3rem;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
    text-decoration: none;
    touch-action: manipulation;
    transition: color 0.2s;
  }

  /* Expand tap area to ≥44px without shifting text. */
  .gate__about::before {
    content: "";
    position: absolute;
    inset: -0.85rem -0.75rem;
  }

  .gate__about::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -0.35rem;
    width: 0;
    height: 1px;
    background: var(--color-accent-ink);
    transition: width 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .gate__about:hover,
  .gate__about:focus-visible { color: var(--color-accent-ink); }
  .gate__about:hover::after,
  .gate__about:focus-visible::after { width: 100%; }

  @media (min-width: 640px) {
    .gate__routes {
      margin-top: 3.25rem;
      flex-direction: row;
      border-radius: 9999px;
    }
    .gate__route { padding: 0.95rem 1.25rem; }
    .gate__route + .gate__route {
      box-shadow: inset 1px 0 0 rgba(26, 25, 23, 0.09);
    }
  }

  /* ── Scroll cue — hints at the work section below the fold ──── */
  .gate__scroll {
    position: absolute;
    left: 50%;
    bottom: 1.25rem;
    transform: translateX(-50%);
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 0.9rem 0;
    font-family: var(--font-sans);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
    text-decoration: none;
    touch-action: manipulation;
    transition: color 0.2s;
  }

  .gate__scroll:hover,
  .gate__scroll:focus-visible { color: var(--color-accent-ink); }

  .gate__scroll-line {
    position: relative;
    width: 1px;
    height: 2.5rem;
    background: currentColor;
    opacity: 0.35;
    overflow: hidden;
  }

  /* A short bright segment sweeps down the hairline; the static line above
     is the reduced-motion (and resting) presentation. */
  @media (prefers-reduced-motion: no-preference) {
    .gate__scroll-line::after {
      content: "";
      position: absolute;
      inset: 0 0 auto 0;
      height: 40%;
      background: var(--color-ink);
      animation: gate-scroll-sweep 2.4s cubic-bezier(0.4, 0, 0.4, 1) infinite;
    }
    @keyframes gate-scroll-sweep {
      0%        { transform: translateY(-110%); }
      55%, 100% { transform: translateY(260%); }
    }
  }

  /* ── Selected work — 1-2-1-2 editorial rhythm ────────────────── */
  /* Frameless mosaic: full-bleed, zero gutters, flush against the gate —
     the tiles read as one stitched block. */
  .work__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }

  .work__item {
    position: relative;
    display: block;
    overflow: hidden;
    background: var(--color-paper-alt);
  }

  /* Soft vignette running from each tile's edges toward its centre — frames
     every image without drawing a border line, so the mosaic stays seamless. */
  .work__item::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    box-shadow:
      inset 0 0 1.25rem rgba(26, 25, 23, 0.10),
      inset 0 0 3.5rem rgba(26, 25, 23, 0.20);
  }

  .work__item--full { grid-column: 1 / -1; }

  .work__img {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    transform: scale(1.04);
    filter: grayscale(15%);
    transition: transform 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                filter    0.6s;
  }

  /* Full rows read as wide editorial banners; on phones they relax to 4:3
     so they don't shrink to a letterbox strip. */
  .work__item--full .work__img { aspect-ratio: 4 / 3; }

  .work__item:hover .work__img,
  .work__item:focus-visible .work__img {
    transform: scale(1);
    filter: grayscale(0%);
  }

  @media (min-width: 640px) {
    .work__item--full .work__img { aspect-ratio: 16 / 9; }
  }
</style>

<script>
  // Bright aura follows the cursor across the splitter gradient.
  // Hover-capable pointers only; fades out when the cursor leaves.
  const gate = document.querySelector<HTMLElement>(".gate");

  if (gate && window.matchMedia("(hover: hover)").matches) {
    const move = (e: PointerEvent) => {
      const r = gate.getBoundingClientRect();
      gate.style.setProperty("--mx", `${((e.clientX - r.left) / r.width) * 100}%`);
      gate.style.setProperty("--my", `${((e.clientY - r.top) / r.height) * 100}%`);
      gate.style.setProperty("--aura", "1");
    };
    gate.addEventListener("pointermove", move);
    gate.addEventListener("pointerleave", () => gate.style.setProperty("--aura", "0"));
  }
</script>
