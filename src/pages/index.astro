---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE, NAV } from "../consts";
import { collections } from "../data/photography";
import { projects } from "../data/three-d";
import { srcset, dims } from "../lib/responsive";

// The gate is a two-way splitter and nothing else: one screen, no scroll, the
// two disciplines carrying exactly half the viewport each. Routes and labels
// come from NAV so consts.ts stays the single source of site-wide copy.
const design = NAV.find((i) => i.href === "/productions");
const photo = NAV.find((i) => i.href === "/photography");
const about = NAV.find((i) => i.href === "/about");
if (!design || !photo || !about) {
  throw new Error("Home gate: NAV is missing /productions, /photography or /about");
}

// One cover per route, pulled from the data files so a swapped cover updates
// here too. Counts are derived, never typed — they cannot drift from reality.
const cover = (src: string | undefined, what: string) => {
  if (!src) throw new Error(`Home gate: no cover for ${what}`);
  return { src, d: dims(src), set: srcset(src) };
};
const designArt = cover(
  projects.find((p) => p.slug === "mojo-swoptops")?.cover,
  'production "mojo-swoptops"',
);
const photoArt = cover(
  collections.find((c) => c.slug === "in-the-studio")?.cover,
  'collection "in-the-studio"',
);
---

<BaseLayout description={SITE.description} noNav noFooter>
  <section class="gate">
    <nav class="gate__routes" aria-label="Enter the portfolio">
      <a href={design.href} class="gate__route gate__route--design">
        <img
          src={designArt.src}
          srcset={designArt.set}
          sizes="100vw"
          alt=""
          width={designArt.d?.w ?? 1600}
          height={designArt.d?.h ?? 1067}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="gate__art"
        />
        <span class="gate__scrim" aria-hidden="true"></span>
        <span class="gate__label">
          <span class="gate__kicker">The rendered form</span>
          <span class="gate__discipline">{design.label}</span>
          <span class="gate__enter">
            {projects.length} projects
            <svg viewBox="0 0 26 10" class="gate__arrow" aria-hidden="true">
              <path d="M0 5h22M19 1l4 4-4 4" />
            </svg>
          </span>
        </span>
      </a>

      <a href={photo.href} class="gate__route gate__route--photo">
        <img
          src={photoArt.src}
          srcset={photoArt.set}
          sizes="100vw"
          alt=""
          width={photoArt.d?.w ?? 1600}
          height={photoArt.d?.h ?? 1067}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="gate__art"
        />
        <span class="gate__scrim" aria-hidden="true"></span>
        <span class="gate__label">
          <span class="gate__kicker">The still image</span>
          <span class="gate__discipline">{photo.label}</span>
          <span class="gate__enter">
            {collections.length} collections
            <svg viewBox="0 0 26 10" class="gate__arrow" aria-hidden="true">
              <path d="M0 5h22M19 1l4 4-4 4" />
            </svg>
          </span>
        </span>
      </a>
    </nav>

    {/* The cut itself. An SVG line rather than a rotated element, because a
        rotated hairline needs an angle and the angle here depends on the
        viewport's aspect ratio; `preserveAspectRatio="none"` plus a
        non-scaling stroke draws it exactly corner-to-corner at any size. Two
        lines, one per breakpoint — see the geometry note in the stylesheet. */}
    <svg
      class="gate__seam"
      viewBox="0 0 100 100"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <line class="gate__seam-wide" x1="100" y1="0" x2="0" y2="100" vector-effect="non-scaling-stroke" />
      <line class="gate__seam-narrow" x1="0" y1="56" x2="100" y2="44" vector-effect="non-scaling-stroke" />
    </svg>

    <div class="gate__id">
      <h1 class="gate__name">{SITE.name}</h1>
      <p class="gate__role">{SITE.role}</p>
      <div class="gate__meta">
        <a href={about.href}>{about.label}</a>
        <span class="gate__dot" aria-hidden="true"></span>
        <a href={about.href}>Contact</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── The gate ──────────────────────────────────────────────────
     One screen, never scrolled. Two routes, one diagonal cut.

     THE GEOMETRY, because it is the whole idea and it is easy to break:
     any straight line through the centre of a rectangle divides it into two
     equal halves, at ANY angle. Both clip-paths below therefore hinge on the
     cut passing through 50%/50%, and the two endpoints staying symmetric
     about it (100%,0 ↔ 0,100% wide; 0,56% ↔ 100%,44% narrow). Keep that
     symmetry and the 50/50 split survives every viewport, portrait or
     landscape, with no measurement. Break it — nudge one endpoint without
     the other — and one discipline silently gets the bigger half. */
  .gate {
    position: relative;
    height: 100svh;
    overflow: hidden;
    background: var(--color-ink);
  }

  .gate__routes {
    position: absolute;
    inset: 0;
  }

  .gate__route {
    position: absolute;
    inset: 0;
    display: block;
    text-decoration: none;
    /* clip-path clips hit-testing too, so each link only answers clicks
       inside its own triangle — no overlay maths needed. */
  }

  /* Wide: corner to corner. Design takes the upper-left triangle,
     photography the lower-right. */
  .gate__route--design { clip-path: polygon(0 0, 100% 0, 0 100%); }
  .gate__route--photo  { clip-path: polygon(100% 0, 100% 100%, 0 100%); }

  .gate__art {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1);
    transition: transform 1s var(--ease-out-expo);
  }

  .gate__route--design .gate__art { object-position: 50% 55%; }
  .gate__route--photo  .gate__art { object-position: 50% 40%; }

  /* Each half darkens toward its own outer corner, so the label always sits
     on the densest part of its own triangle. */
  .gate__scrim {
    position: absolute;
    inset: 0;
    display: block;
    /* Hovering a route lifts 30% of its own scrim, so the half you are
       pointing at brightens while the other stays put — the reveal is the
       affordance. Scaling the whole element's opacity (rather than editing
       the stops) keeps the gradient's shape intact and stays honestly "the
       gradient at 70%". */
    opacity: 1;
    transition: opacity 0.5s var(--ease-out-expo);
  }

  .gate__route:hover .gate__scrim,
  .gate__route:focus-visible .gate__scrim {
    opacity: 0.7;
  }

  /* Angles are not interchangeable: 330deg ends (darkest) at the TOP-LEFT,
     150deg at the BOTTOM-RIGHT — each one pointing at its own label's
     corner. Swap them and every label lands on the brightest part of its
     own half, which is exactly where a white word disappears. */
  .gate__route--design .gate__scrim {
    background: linear-gradient(
      330deg,
      rgba(26, 25, 23, 0.15) 0%,
      rgba(26, 25, 23, 0.31) 52%,
      rgba(26, 25, 23, 0.44) 100%
    );
  }

  .gate__route--photo .gate__scrim {
    background: linear-gradient(
      150deg,
      rgba(26, 25, 23, 0.15) 0%,
      rgba(26, 25, 23, 0.31) 52%,
      rgba(26, 25, 23, 0.44) 100%
    );
  }

  /* ── Route labels — each in the fat corner of its own triangle ── */
  .gate__label {
    position: absolute;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    max-width: min(30rem, 68vw);
    color: var(--color-paper);
  }

  .gate__route--design .gate__label {
    top: clamp(4rem, 13vh, 7.5rem);
    left: clamp(1.5rem, 6vw, 5.75rem);
  }

  .gate__route--photo .gate__label {
    right: clamp(1.5rem, 6vw, 5.75rem);
    bottom: clamp(4rem, 13vh, 7.5rem);
    align-items: flex-end;
    text-align: right;
  }

  .gate__kicker {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(250, 250, 248, 0.74);
  }

  .gate__discipline {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.5rem, 6.4vw, 5rem);
    line-height: 0.98;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .gate__enter {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    min-height: 2.75rem; /* 44px touch target */
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: var(--letter-spacing-caps);
    text-transform: uppercase;
    color: rgba(250, 250, 248, 0.88);
  }

  .gate__arrow {
    width: 1.625rem;
    height: 0.625rem;
    flex: none;
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.5;
    transition: transform 0.4s var(--ease-out-expo);
  }

  .gate__route:hover .gate__arrow,
  .gate__route:focus-visible .gate__arrow {
    transform: translateX(0.4rem);
  }

  .gate__route:hover .gate__art,
  .gate__route:focus-visible .gate__art {
    transform: scale(1.03);
  }

  /* ── The cut ───────────────────────────────────────────────────── */
  .gate__seam {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    stroke: rgba(250, 250, 248, 0.55);
    stroke-width: 1;
  }

  .gate__seam-narrow { display: none; }

  /* ── Identity — sits astride the cut, so it belongs to neither route ──
     Anything that is not one of the two destinations lives in this block.
     Put it anywhere else and it lands inside one triangle and quietly
     takes a side. It carries its own scrim: the artwork behind it is a
     photograph or a render, and a hairline alone will not hold against it
     (see the nav-pill rule in CLAUDE.md — same problem, same fix). */
  .gate__id {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    z-index: 2;
    width: min(28.25rem, calc(100vw - 3.5rem));
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 1.5rem 2rem 1.15rem;
    background: rgba(26, 25, 23, 0.86);
    border: 1px solid rgba(250, 250, 248, 0.26);
    border-radius: var(--radius-identity);
    text-align: center;

    /* One half of the identity morph. This card and the nav pill share
       this name, so choosing a discipline flies the card up into the
       pill rather than cutting to it. The choreography is in global.css
       — it has to be: the ::view-transition pseudo-elements hang off the
       document root and an Astro-scoped selector would never match them.
       Reduced motion drops the name (below), which dissolves the pair and
       leaves the plain page cross-fade. */
    view-transition-name: site-identity;
  }

  .gate__name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.35rem, 3.2vw, 1.85rem);
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--color-paper);

    /* Nested inside the card's morph: the name is lifted out of the
       card snapshot and travels as its own object, so it shrinks and
       slides into the pill's brand rather than dissolving into it.
       Same curve and duration as the card (global.css) — one object. */
    view-transition-name: site-name;
  }

  .gate__role {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: rgba(250, 250, 248, 0.66);
  }

  .gate__meta {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-top: 0.6rem;
    padding-top: 0.7rem;
    border-top: 1px solid rgba(250, 250, 248, 0.18);
    width: 100%;
    justify-content: center;
  }

  .gate__meta a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem; /* 44px touch target */
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    color: rgba(250, 250, 248, 0.82);
    transition: color 0.25s;
  }

  .gate__meta a:hover,
  .gate__meta a:focus-visible { color: var(--color-paper); }

  .gate__dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: rgba(250, 250, 248, 0.36);
  }

  /* ── Narrow / portrait ─────────────────────────────────────────
     Corner-to-corner on a tall screen leaves two slivers with nowhere to put
     a word, so the cut shallows out: same line through the same centre,
     different angle. Regions become top and bottom; each label keeps the
     deep corner of its own region. */
  @media (max-width: 900px) {
    .gate__route--design { clip-path: polygon(0 0, 100% 0, 100% 44%, 0 56%); }
    .gate__route--photo  { clip-path: polygon(0 56%, 100% 44%, 100% 100%, 0 100%); }

    .gate__seam-wide { display: none; }
    .gate__seam-narrow { display: inline; }

    .gate__route--design .gate__label {
      top: clamp(3.5rem, 9vh, 5.5rem);
      left: 1.625rem;
    }

    .gate__route--photo .gate__label {
      right: 1.625rem;
      bottom: clamp(3.5rem, 9vh, 5.5rem);
    }

    .gate__discipline { font-size: clamp(2.25rem, 11vw, 3.25rem); }
  }

  /* Reduced motion drops the movement, not the feedback: the scrim still
     lifts on hover, it just does so without an eased fade. */
  @media (prefers-reduced-motion: reduce) {
    .gate__art,
    .gate__arrow,
    .gate__scrim { transition: none; }
    .gate__route:hover .gate__art,
    .gate__route:focus-visible .gate__art { transform: none; }

    /* Dropping the name unpairs the card from the nav pill, so no
       morph group is formed and the two pages simply cross-fade.
       Softened, not removed. */
    .gate__id,
    .gate__name { view-transition-name: none; }
  }
</style>
