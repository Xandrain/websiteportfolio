---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProfileBlock from "../components/about/ProfileBlock.astro";
import { SITE } from "../consts";
import { abs, breadcrumbs, personRef } from "../lib/schema";

const origin = Astro.site ?? Astro.url.origin;

// ProfilePage is a Google rich-result type for creator profiles — it tells
// search engines this page is the authoritative "who is this person" page.
const schema = [
  {
    "@type": "ProfilePage",
    "@id": abs(origin, "/about/"),
    url: abs(origin, "/about/"),
    name: `About ${SITE.name}`,
    mainEntity: personRef(origin),
  },
  breadcrumbs(origin, [
    { name: "Home", path: "/" },
    { name: "About", path: "/about/" },
  ]),
];
---

<BaseLayout
  title="About"
  description={`About ${SITE.name} — ${SITE.role}. ${SITE.tagline}`}
  schema={schema}
>
  <h1 class="sr-only">About Alexandre Haineaux</h1>

  <div class="profile-bg">
    <ProfileBlock />
  </div>
</BaseLayout>

<style>
  .profile-bg {
    position: relative;
    padding-top: 6rem; /* compensate for fixed nav */
  }

  .profile-bg::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 75% 55% at 50% 25%,
      rgba(210, 202, 190, 0.18) 0%,
      transparent 72%
    );
    pointer-events: none;
    z-index: 0;
  }

  .profile-bg > * {
    position: relative;
    z-index: 1;
  }
</style>
