---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

// All published entries, newest first.
const entries = (await getCollection("journal", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const fmt = (d: Date) =>
  d.toLocaleDateString("en-GB", { year: "numeric", month: "long", day: "numeric" });
---

<BaseLayout
  title="Journal"
  description="Notes on light, restraint, and making images in two and three dimensions."
>
  <h1 class="sr-only">Journal</h1>

  <section class="mx-auto w-full max-w-editorial px-6 pt-28 sm:px-8 sm:pt-32 lg:px-12">
    <ul class="divide-y divide-line">
      {
        entries.map((entry) => (
          <li>
            <a
              href={`/journal/${entry.id}`}
              class="group grid gap-2 py-8 transition-opacity duration-300 sm:grid-cols-[10rem_1fr] sm:gap-8"
            >
              <time class="label pt-1" datetime={entry.data.date.toISOString()}>
                {fmt(entry.data.date)}
              </time>
              <div>
                <h2 class="font-display text-3xl text-ink sm:text-4xl">
                  {entry.data.title}
                </h2>
                <p class="mt-2 max-w-prose text-ink-soft">{entry.data.description}</p>
                <span class="mt-4 inline-flex items-center gap-2 text-xs uppercase tracking-label text-ink">
                  Read
                  <span class="inline-block transition-transform duration-300 group-hover:translate-x-1">
                    →
                  </span>
                </span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
