---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const entries = await getCollection("journal", ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

type Props = { entry: CollectionEntry<"journal"> };
const { entry } = Astro.props;
const { Content } = await render(entry);

const fmt = (d: Date) =>
  d.toLocaleDateString("en-GB", { year: "numeric", month: "long", day: "numeric" });
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <article class="mx-auto w-full max-w-prose px-6 pt-36 sm:pt-44">
    <a
      href="/journal"
      class="group inline-flex items-center gap-2 text-xs uppercase tracking-label text-ink-muted transition-colors hover:text-ink"
    >
      <span class="inline-block transition-transform duration-300 group-hover:-translate-x-1">
        ←
      </span>
      Journal
    </a>

    <header class="mt-10 border-b border-line pb-10">
      <time class="label" datetime={entry.data.date.toISOString()}>
        {fmt(entry.data.date)}
      </time>
      <h1 class="mt-5 font-display text-5xl leading-[1] tracking-tight text-ink sm:text-6xl">
        {entry.data.title}
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-ink-soft">{entry.data.description}</p>
    </header>

    <div
      class="prose-editorial mt-10 leading-relaxed text-ink-soft [&_h2]:mt-12 [&_h2]:font-display [&_h2]:text-2xl [&_h2]:text-ink [&_p]:mt-6"
    >
      <Content />
    </div>
  </article>
</BaseLayout>
