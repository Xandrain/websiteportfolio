---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DisciplineSwitch from "../../components/shared/DisciplineSwitch.astro";
import ProductionsSubNav from "../../components/productions/ProductionsSubNav.astro";
import { projects } from "../../data/three-d";
import { srcset, dims } from "../../lib/responsive";

const productionsList = projects.filter((p) => p.category === "productions");
---

<BaseLayout
  title="Graphic Design & 3D"
  description="3D and graphic design work by Alexandre Haineaux — character modelling, rigging, and texturing for animated television, alongside personal studies."
>
  <h1 class="sr-only">Productions</h1>

  <div class="subnav-spacer" aria-hidden="true"></div>
  <ProductionsSubNav active="productions" />

  <!-- Bento: the first project in three-d.ts leads at double size, every
       other one is a square beside or below it. The cover's alt is empty on
       purpose: the <h2> inside the same link already names it, and a screen
       reader would otherwise hear it twice. -->
  <section class="bento-section editorial" aria-label="Projects">
    <div class="bento">
      {productionsList.map((project, i) => {
        const d = dims(project.cover);
        const lead = i === 0;
        return (
          <a href={`/productions/${project.slug}`} class:list={["tile", { "tile--lead": lead }]}>
            <div class="tile__media">
              <img
                src={project.cover}
                srcset={srcset(project.cover)}
                sizes={lead
                  ? "(min-width: 1024px) min(552px, 48vw), 100vw"
                  : "(min-width: 1024px) min(268px, 24vw), 50vw"}
                alt=""
                width={d?.w ?? 1600}
                height={d?.h ?? 1600}
                loading={lead ? "eager" : "lazy"}
                fetchpriority={lead ? "high" : undefined}
                decoding="async"
                class="tile__img"
              />

              <div class="tile__scrim" aria-hidden="true"></div>
            </div>

            <div class="tile__body">
              <h2 class="tile__title">{project.title}</h2>
              <p class="tile__tags">{project.tags.slice(0, lead ? 2 : 1).join(" · ")}</p>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <DisciplineSwitch label="Also explore" href="/photography" name="Photography" />
</BaseLayout>

<style>
  .subnav-spacer { height: 5.5rem; }

  .bento-section { padding-block: 3rem 0; }

  /* Every tile is a square, because the covers are square masters — the
     whole point of this layout is that none of them is cropped. The lead
     spans two columns (and two rows from 1024px), so with aspect-ratio on
     every tile it lands exactly two squares plus one gap on each side.
     Five projects fill 1 + 4 at desktop; a sixth starts a row of squares
     under the lead, which still reads as intended. */
  .bento {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }

  @media (min-width: 1024px) {
    .bento { grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  }

  .tile {
    position: relative;
    display: block;
    text-decoration: none;
  }

  .tile--lead { grid-column: span 2; }

  @media (min-width: 1024px) {
    .tile--lead { grid-row: span 2; }
  }

  /* The square lives on the media box, not the link, so a phone tile can
     carry its caption underneath without the caption eating the square. */
  .tile__media {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--color-ink);
  }

  .tile__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    /* Square cover in a square tile: a no-op except for a non-square master
       (Carl, 16:9), which is cropped to its centre. */
    object-fit: cover;
    transition: transform 0.8s var(--ease-out-expo);
  }

  .tile:hover .tile__img { transform: scale(1.04); }

  @media (prefers-reduced-motion: reduce) {
    .tile__img { transition: none; }
    .tile:hover .tile__img { transform: none; }
  }

  /* White type sits straight over the artwork's bottom edge. The small
     tiles' titles are under the 24px "large text" size, so they need 4.5:1,
     not 3:1 — the stops hold the bottom of the tile dark through the
     title's whole line box and fade out above it. Re-measure if the stops,
     the type or a cover change (CLAUDE.md, "Swapping a /productions cover"). */
  .tile__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to top,
      rgba(10, 9, 8, 0.9)  0%,
      rgba(10, 9, 8, 0.78) 26%,
      rgba(10, 9, 8, 0.34) 50%,
      rgba(10, 9, 8, 0)    68%
    );
  }

  .tile__body {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
    padding: 0.875rem;
  }

  .tile__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.0625rem, 1.6vw, 1.5rem);
    line-height: 1.08;
    letter-spacing: -0.01em;
    color: #FFFFFF;
    text-wrap: balance;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.35);
  }

  .tile__tags {
    margin: 0;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: var(--letter-spacing-caps);
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.86);
  }

  .tile--lead .tile__title { font-size: clamp(1.625rem, 3.2vw, 2.875rem); }

  /* Phone: a small tile is ~160px square, and a two- or three-line title
     climbs past the dark end of the scrim — measured 1.6:1 at 360px. Rather
     than darken most of the square, the four small tiles set their caption
     under the image in ink on paper. The lead is wide enough to keep its
     overlay (14:1). */
  @media (max-width: 639.98px) {
    .tile:not(.tile--lead) .tile__scrim { display: none; }

    .tile:not(.tile--lead) .tile__body {
      position: static;
      gap: 0.25rem;
      padding: 0.625rem 0 0;
    }

    .tile:not(.tile--lead) .tile__title {
      color: var(--color-ink);
      text-shadow: none;
    }

    .tile:not(.tile--lead) .tile__tags { color: var(--color-ink-muted); }
  }

  @media (min-width: 640px) {
    .tile__body { padding: 1.25rem; }
    .tile--lead .tile__body { padding: 1.75rem; gap: 0.75rem; }
  }
</style>
