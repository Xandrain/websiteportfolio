---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/productions/ProjectCard.astro";
import DisciplineSwitch from "../../components/shared/DisciplineSwitch.astro";
import ProductionsSubNav from "../../components/productions/ProductionsSubNav.astro";
import { projects } from "../../data/three-d";
import { srcset, dims } from "../../lib/responsive";

const productionsList = projects.filter((p) => p.category === "productions");
const [featured, ...rest] = productionsList;
const featuredDims = featured ? dims(featured.cover) : undefined;
---

<BaseLayout
  title="Graphic Design & 3D"
  description="3D and graphic design work by Alexandre Haineaux — character modeling, rigging, and texturing for animated television, alongside personal studies."
>
  <h1 class="sr-only">Productions</h1>

  <div class="subnav-spacer" aria-hidden="true"></div>
  <ProductionsSubNav active="productions" />

  <!-- Featured plate: the cover inset on the left, the credit read off as a
       spec column on the right. -->
  {featured && (
    <section class="featured editorial" aria-label="Featured project">
      <div class="plate">
        <div class="plate__media">
          <div class="plate__well">
            <img
              src={featured.cover}
              srcset={srcset(featured.cover)}
              sizes="(min-width: 1024px) 700px, (min-width: 900px) 60vw, 100vw"
              alt={`${featured.title} — Graphic Design & 3D project`}
              width={featuredDims?.w ?? 1600}
              height={featuredDims?.h ?? 1000}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="plate__img"
            />
          </div>
        </div>

        <div class="plate__info">
          <p class="plate__kicker">01 — Featured</p>

          <h2 class="plate__title">
            <a href={`/productions/${featured.slug}`} class="plate__link">
              {featured.title}
            </a>
          </h2>

          {featured.specs && featured.specs.length > 0 && (
            <dl class="specs">
              {featured.specs.map((row) => (
                <div class="specs__row">
                  <dt class="specs__label">{row.label}</dt>
                  <dd class="specs__value">{row.value}</dd>
                </div>
              ))}
            </dl>
          )}

          <div class="plate__spacer"></div>

          <a href={`/productions/${featured.slug}`} class="plate__cta">
            View project →
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- The rest, as plates -->
  {rest.length > 0 && (
    <section class="plates editorial" aria-label="More projects">
      <div class="plates__grid">
        {rest.map((project, i) => (
          <ProjectCard project={project} variant="plate" index={i + 2} />
        ))}
      </div>
    </section>
  )}

  <DisciplineSwitch label="Also explore" href="/photography" name="Photography" />
</BaseLayout>

<style>
  .subnav-spacer { height: 5.5rem; }

  /* ── Featured plate ───────────────────────────────────────── */
  .featured { padding-block: 3rem 0; }

  .plate {
    display: grid;
    grid-template-columns: 1fr;
    border-radius: 0.375rem;
    background: var(--color-paper-alt);
    box-shadow: inset 0 0 0 1px var(--color-line),
                0 18px 44px rgba(26, 25, 23, 0.06);
    overflow: hidden;
  }

  @media (min-width: 900px) {
    .plate { grid-template-columns: 1.9fr 1fr; }
  }

  .plate__media { padding: 1.25rem; }

  /* The image sits in a well of page-coloured ground, not flush to the plate
     edge — that margin is what makes a render read as a mounted object. */
  .plate__well {
    overflow: hidden;
    border-radius: 0.1875rem;
    background: var(--color-paper);
    aspect-ratio: 16 / 10;
  }

  .plate__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .plate__info {
    display: flex;
    flex-direction: column;
    padding: 2rem 1.75rem 1.75rem;
    border-top: 1px solid var(--color-line);
  }

  @media (min-width: 900px) {
    .plate__info {
      padding: 2.5rem 2.25rem 2.25rem;
      border-top: 0;
      border-left: 1px solid var(--color-line);
    }
  }

  .plate__kicker {
    margin: 0;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: var(--letter-spacing-caps);
    text-transform: uppercase;
    color: var(--color-accent-ink);
  }

  .plate__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.875rem, 2.8vw, 2.375rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    margin: 1.125rem 0 0;
  }

  .plate__link {
    color: inherit;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .plate__link:hover { opacity: 0.7; }

  .plate__spacer { flex-grow: 1; min-height: 2rem; }

  .plate__cta {
    align-self: flex-start;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-accent-ink);
    border-bottom: 1px solid oklch(from #0C6B43 l c h / 0.35);
    padding-bottom: 0.25rem;
    transition: border-color 0.25s;
  }

  .plate__cta:hover { border-color: var(--color-accent-ink); }

  /* Spec rows — hairlines only, so the column reads as a breakdown rather
     than a boxed table. */
  .specs { margin: 1.75rem 0 0; }

  .specs__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 0;
    border-top: 1px solid var(--color-line);
  }

  .specs__row:last-child { border-bottom: 1px solid var(--color-line); }

  .specs__label {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: var(--letter-spacing-label);
    text-transform: uppercase;
    color: var(--color-ink-muted);
    white-space: nowrap;
  }

  .specs__value {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-ink);
    text-align: right;
  }

  /* ── Plates ───────────────────────────────────────────────── */
  .plates { padding-block: 1.5rem 0; }

  .plates__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .plates__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
