---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DisciplineSwitch from "../../components/shared/DisciplineSwitch.astro";
import ProductionsSubNav from "../../components/productions/ProductionsSubNav.astro";
import YouTubeEmbed from "../../components/productions/YouTubeEmbed.astro";
import { projects } from "../../data/three-d";
import { srcset } from "../../lib/responsive";
import { gallery, type GalleryItem } from "../../lib/media";

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props;

const isPV = project.category === "product-visualisation";
const backHref = isPV ? "/productions/product-visualisation" : "/productions";
const backLabel = isPV ? "Product Visualisation" : "Graphic Design & 3D";

const items = gallery(project);

// Layout driven by each item's aspect ratio: landscape media span the full
// editorial width, squarish/portrait media flow two-up. When a run of two-up
// items has odd length, its first item is promoted to full width so no row is
// left half-empty — unless it's a portrait, which would grow far too tall.
const ratio = (it: GalleryItem) => (it.w && it.h ? it.w / it.h : 1);
const spans = items.map((it) => (ratio(it) >= 1.25 ? 2 : 1));
let runStart = -1;
for (let i = 0; i <= spans.length; i++) {
  if (i < spans.length && spans[i] === 1) {
    if (runStart < 0) runStart = i;
    continue;
  }
  if (runStart >= 0) {
    if ((i - runStart) % 2 === 1 && ratio(items[runStart]) >= 0.9) spans[runStart] = 2;
    runStart = -1;
  }
}

const SIZES_FULL = "(min-width: 1280px) 1104px, 100vw";
const SIZES_HALF = "(min-width: 1280px) 544px, (min-width: 640px) 50vw, 100vw";
---

<BaseLayout title={project.title} description={project.description} image={project.cover}>

  <!-- Header -->
  <section class="project-header">
    <div class="project-header__inner">
      <a href={backHref} class="back-link">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <polyline points="10,2 4,8 10,14" stroke="currentColor" stroke-width="1.25"
            stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        {backLabel}
      </a>

      <div>
        <div class="project-header__meta">
          <span class="label">{project.year}</span>
          {project.tags.map((t) => <span class="label">{t}</span>)}
        </div>
        <h1 class="project-header__title">{project.title}</h1>
        <p class="project-header__desc">{project.description}</p>
      </div>
    </div>
  </section>

  <ProductionsSubNav active={project.category} />

  <!-- Gallery: images + self-hosted video loops, derived from the project folder -->
  {items.length > 0 && (
    <section class="project-images" aria-label="Project media">
      <div class="project-images__grid">
        {items.map((item, i) => {
          const span2 = spans[i] === 2;
          const ar = item.w && item.h ? `aspect-ratio:${item.w}/${item.h}` : undefined;
          return (
            <div class:list={["project-image-wrap", span2 && "span-2"]} style={ar}>
              {item.kind === "video" ? (
                <video
                  class="project-video"
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  poster={item.poster}
                  width={item.w}
                  height={item.h}
                  tabindex="0"
                  aria-label={`${project.title} — animation ${i + 1}. Click or press Enter to pause.`}
                >
                  {item.webm && <source src={item.webm} type="video/webm" />}
                  {item.mp4 && <source src={item.mp4} type="video/mp4" />}
                </video>
              ) : (
                <img
                  src={item.src}
                  srcset={srcset(item.src)}
                  sizes={span2 ? SIZES_FULL : SIZES_HALF}
                  alt={`${project.title} — view ${i + 1}`}
                  width={item.w ?? 1600}
                  height={item.h ?? 900}
                  loading={i < 2 ? "eager" : "lazy"}
                  fetchpriority={i === 0 ? "high" : undefined}
                  decoding="async"
                  class="project-image"
                />
              )}
            </div>
          );
        })}
      </div>
    </section>
  )}

  <!-- YouTube (turnarounds, breakdowns) — click-to-load facade, nothing
       third-party is requested until the visitor presses play -->
  {project.youtube && project.youtube.length > 0 && (
    <section class="project-yt" aria-label="Project videos">
      {project.youtube.map((v) => (
        <YouTubeEmbed slug={project.slug} id={v.id} title={v.title} />
      ))}
    </section>
  )}

  <!-- Footer -->
  <div class="project-footer">
    <div class="project-footer__inner">
      <a href="/productions" class="back-link">← All projects</a>
    </div>
  </div>

  <DisciplineSwitch label="Also explore" href="/photography" name="Photography" />
</BaseLayout>

<script>
  // Looping videos: honour prefers-reduced-motion (start paused, show native
  // controls) and give everyone a pause control — click or Enter/Space toggles
  // playback (WCAG 2.2.2).
  const videos = document.querySelectorAll<HTMLVideoElement>(".project-video");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  videos.forEach((v) => {
    if (reduce) {
      v.removeAttribute("autoplay");
      v.pause();
      v.controls = true;
      return;
    }
    const toggle = () => (v.paused ? v.play() : v.pause());
    v.addEventListener("click", toggle);
    v.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        toggle();
      }
    });
  });
</script>

<style>
  .project-header {
    padding-top: 6.5rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--color-line);
  }

  /* Clear the taller stacked nav on small screens (back-link sits first). */
  @media (max-width: 560px) {
    .project-header { padding-top: 8.5rem; }
  }

  .project-header__inner {
    max-width: var(--max-width-editorial);
    margin-inline: auto;
    padding-inline: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  @media (min-width: 640px)  { .project-header__inner { padding-inline: 2rem; } }
  @media (min-width: 1024px) { .project-header__inner { padding-inline: 3rem; } }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--color-ink-muted);
    transition: color 0.2s;
  }

  .back-link:hover { color: var(--color-ink); }

  .project-header__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-bottom: 0.875rem;
  }

  .project-header__title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 6vw, 6.5rem);
    font-weight: 400;
    line-height: 1.0;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    margin-bottom: 1.125rem;
  }

  .project-header__desc {
    max-width: 55ch;
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-ink-soft);
  }

  /* ── Gallery ─────────────────────────────────────────────── */
  .project-images {
    max-width: var(--max-width-editorial);
    margin-inline: auto;
    padding: 3rem 1.5rem 0;
  }

  @media (min-width: 640px)  { .project-images { padding-inline: 2rem; } }
  @media (min-width: 1024px) { .project-images { padding-inline: 3rem; } }

  .project-images__grid {
    display: grid;
    grid-template-columns: 1fr;
    align-items: start;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .project-images__grid { grid-template-columns: repeat(2, 1fr); }
    .project-image-wrap.span-2 { grid-column: span 2; }
  }

  .project-image-wrap { overflow: hidden; background: var(--color-paper-alt); }

  .project-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: grayscale(12%);
    transition: filter 0.5s;
  }

  .project-image:hover { filter: grayscale(0%); }

  .project-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    cursor: pointer;
  }

  .project-video:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }

  /* ── YouTube ─────────────────────────────────────────────── */
  .project-yt {
    max-width: var(--max-width-editorial);
    margin-inline: auto;
    padding: 1rem 1.5rem 0;
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 640px)  { .project-yt { padding-inline: 2rem; } }
  @media (min-width: 1024px) { .project-yt { padding-inline: 3rem; } }

  /* ── Footer ──────────────────────────────────────────────── */
  .project-footer {
    max-width: var(--max-width-editorial);
    margin-inline: auto;
    padding: 2.5rem 1.5rem 0;
    border-top: 1px solid var(--color-line);
    margin-top: 3.5rem;
  }

  @media (min-width: 640px) { .project-footer { padding-inline: 2rem; } }
</style>
