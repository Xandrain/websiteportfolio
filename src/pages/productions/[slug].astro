---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DisciplineSwitch from "../../components/shared/DisciplineSwitch.astro";
import YouTubeEmbed from "../../components/productions/YouTubeEmbed.astro";
import ProjectReel from "../../components/productions/ProjectReel.astro";
import { projects } from "../../data/three-d";
import { srcset } from "../../lib/responsive";
import { gallery, reel, type GalleryItem } from "../../lib/media";
import { abs, breadcrumbs, personRef } from "../../lib/schema";

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props;

const isPV = project.category === "product-visualisation";
const backHref = isPV ? "/productions/product-visualisation" : "/productions";
const backLabel = isPV ? "Product Visualisation" : "Graphic Design & 3D";

const origin = Astro.site ?? Astro.url.origin;
const pageUrl = abs(origin, `/productions/${project.slug}/`);

const schema = [
  breadcrumbs(origin, [
    { name: "Home", path: "/" },
    { name: "Graphic Design & 3D", path: "/productions/" },
    ...(isPV
      ? [{ name: "Product Visualisation", path: "/productions/product-visualisation/" }]
      : []),
    { name: project.title, path: `/productions/${project.slug}/` },
  ]),
  {
    "@type": "VisualArtwork",
    "@id": `${pageUrl}#artwork`,
    url: pageUrl,
    name: project.title,
    description: project.description,
    image: abs(origin, project.cover),
    keywords: project.tags.join(", "),
    artMedium: "Digital",
    creator: personRef(origin),
  },
];

const items = gallery(project);
const showreel = reel(project);

// Layout driven by each item's aspect ratio: landscape media span the full
// editorial width, squarish/portrait media flow two-up. When a run of two-up
// items has odd length, its first item is promoted to full width so no row is
// left half-empty — unless it's a portrait, which would grow far too tall.
const ratio = (it: GalleryItem) => (it.w && it.h ? it.w / it.h : 1);
const spans = items.map((it) => (ratio(it) >= 1.25 ? 2 : 1));
let runStart = -1;
for (let i = 0; i <= spans.length; i++) {
  if (i < spans.length && spans[i] === 1) {
    if (runStart < 0) runStart = i;
    continue;
  }
  if (runStart >= 0) {
    if ((i - runStart) % 2 === 1 && ratio(items[runStart]) >= 0.9) spans[runStart] = 2;
    runStart = -1;
  }
}

// A reel is a 16:9 hero under an already-tall header, so it pushes the whole
// grid below the fold: the poster becomes the LCP candidate and nothing in the
// gallery is worth eager-loading (these turnarounds run ~1 MB each).
const galleryEager = showreel ? 0 : 2;

const SIZES_FULL = "(min-width: 1280px) 1104px, 100vw";
const SIZES_HALF = "(min-width: 1280px) 544px, (min-width: 640px) 50vw, 100vw";
---

<BaseLayout title={project.title} description={project.description} image={project.cover} schema={schema}>

  <!-- Header -->
  <section class="project-header">
    <div class="project-header__inner editorial">
      <a href={backHref} class="back-link">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <polyline points="10,2 4,8 10,14" stroke="currentColor" stroke-width="1.25"
            stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        {backLabel}
      </a>

      <div>
        <div class="project-header__meta">
          {project.tags.map((t) => <span class="label">{t}</span>)}
        </div>
        <h1 class="project-header__title">{project.title}</h1>
        <p class="project-header__desc">{project.description}</p>
      </div>
    </div>
  </section>

  <!-- Showreel: the project's edited piece, click-to-play so its soundtrack
       survives and nothing but the poster is fetched up front -->
  {showreel && (
    <section class="project-reel editorial" aria-label={`${project.title} showreel`}>
      <ProjectReel
        title={project.title}
        webm={showreel.webm}
        mp4={showreel.mp4}
        poster={showreel.poster}
        w={showreel.w}
        h={showreel.h}
        caption={project.reelCaption ?? "Showreel"}
      />
    </section>
  )}

  <!-- Gallery: images + self-hosted video loops, derived from the project folder -->
  {items.length > 0 && (
    <section class="project-images editorial" aria-label="Project media">
      <div class="project-images__grid">
        {items.map((item, i) => {
          const span2 = spans[i] === 2;
          const ar = item.w && item.h ? `aspect-ratio:${item.w}/${item.h}` : undefined;
          return (
            <div class:list={["project-image-wrap", span2 && "span-2", item.kind === "animation" && "is-alpha"]} style={ar}>
              {item.kind === "video" ? (
                <video
                  class="project-video"
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  poster={item.poster}
                  width={item.w}
                  height={item.h}
                  tabindex="0"
                  aria-label={`${project.title} — animation ${i + 1}. Click or press Enter to pause.`}
                >
                  {item.webm && <source src={item.webm} type="video/webm" />}
                  {item.mp4 && <source src={item.mp4} type="video/mp4" />}
                </video>
              ) : item.kind === "animation" ? (
                <img
                  class="project-anim"
                  src={item.src}
                  data-still={item.poster}
                  data-anim={item.src}
                  data-loop={item.loopMs}
                  alt={`${project.title} — animation ${i + 1}`}
                  width={item.w ?? 1024}
                  height={item.h ?? 1024}
                  loading={i < galleryEager ? "eager" : "lazy"}
                  fetchpriority={i === 0 && !showreel ? "high" : undefined}
                  decoding="async"
                  tabindex="0"
                  aria-label={`${project.title} — animation ${i + 1}. Click or press Enter to pause.`}
                />
              ) : (
                <img
                  src={item.src}
                  srcset={srcset(item.src)}
                  sizes={span2 ? SIZES_FULL : SIZES_HALF}
                  alt={`${project.title} — view ${i + 1}`}
                  width={item.w ?? 1600}
                  height={item.h ?? 900}
                  loading={i < galleryEager ? "eager" : "lazy"}
                  fetchpriority={i === 0 && !showreel ? "high" : undefined}
                  decoding="async"
                  class="project-image"
                />
              )}
            </div>
          );
        })}
      </div>
    </section>
  )}

  <!-- YouTube (turnarounds, breakdowns) — click-to-load facade, nothing
       third-party is requested until the visitor presses play -->
  {project.youtube && project.youtube.length > 0 && (
    <section class="project-yt editorial" aria-label="Project videos">
      {project.youtube.map((v) => (
        <YouTubeEmbed slug={project.slug} id={v.id} title={v.title} />
      ))}
    </section>
  )}

  <!-- Footer -->
  <div class="project-footer editorial">
    <a href="/productions" class="back-link">← All projects</a>
  </div>

  <DisciplineSwitch label="Also explore" href="/photography" name="Photography" />
</BaseLayout>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  /** Click, Enter or Space on an element the markup has made focusable. */
  function onActivate(el: HTMLElement, fn: () => void) {
    el.addEventListener("click", fn);
    el.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        fn();
      }
    });
  }

  // Looping videos: honour prefers-reduced-motion (start paused, show native
  // controls) and give everyone a pause control — click or Enter/Space toggles
  // playback (WCAG 2.2.2).
  for (const v of document.querySelectorAll<HTMLVideoElement>(".project-video")) {
    if (reduce) {
      v.removeAttribute("autoplay");
      v.pause();
      v.controls = true;
    } else {
      onActivate(v, () => (v.paused ? v.play() : v.pause()));
    }
  }

  // ── Animated WebP turnarounds ────────────────────────────────────────
  // Transparent, and holding their last frame — see scripts/gen-anim.mjs.
  // Two things follow from an animated image having no playback API. "Pause"
  // can only mean swapping in the still first frame and back, which is the
  // control at the end of this block. And a loop starts whenever the browser
  // first paints that particular image, so a grid of turnarounds spins in as
  // many phases as it had decode times: encoding the set to one clock
  // (gen-anim.mjs --cadence/--total-ms) made every lap the same length but
  // left the offsets between them exactly where they were.
  //
  // The one moment the page does control is when a loop *begins* — assigning
  // a src whose bytes are already in memory starts that animation at frame 1,
  // now. So the page runs a metronome per loop length and lets an animation
  // in only on a beat. Everything admitted on any beat shares a phase from
  // then on, for as long as the page lives.
  //
  // Three things it depends on, each measured across the three engines rather
  // than assumed:
  //   • Admit from a Blob, as a freshly minted object URL. Re-assigning a URL
  //     the engine has already loaded restarts the loop in Chromium and
  //     WebKit, but rejoins it mid-lap in Firefox — which is the spec, not a
  //     bug: animated images sharing an absolute URL are "rendered
  //     synchronized to the same timeline as a group", and a later one "jumps
  //     to the point in the animation cycle that is currently being
  //     displayed" (HTML Standard, Rendering § Images). A URL the engine has
  //     never seen has no group to join, so it starts at frame 1 everywhere.
  //     Hence neither of the two usual tricks: clearing and re-setting src is
  //     the Firefox case above (bugzilla 210001, 594771), and adding
  //     `?` + Math.random() buys the restart by re-downloading a megabyte.
  //   • Admit only what is on screen. Assigning to an off-screen image does
  //     not start its loop — that happens at the first paint — so it would
  //     begin whenever the visitor scrolled to it, in nobody's phase.
  //   • Waiting for a beat costs nothing to look at. These turnarounds spend
  //     the last ~1.8s of every lap held on the front pose, which is exactly
  //     the still they show while queued, so one waiting to join is
  //     indistinguishable from one holding.
  //
  // After that an animation is left alone: every engine keeps its clock
  // running while it is scrolled past (Blink catches the frame up on the way
  // back), so phase survives scrolling without any help. With JS off, the
  // markup's own animated src plays, unsynchronised.
  //
  // To re-verify after touching any of this: drive the page with Playwright,
  // screenshot each turnaround every ~100ms, and cross-correlate the tiles'
  // frame-to-frame difference signals — in phase they peak at lag 0, which is
  // what Chromium and Firefox both measure. Playwright's headless WebKit
  // renders these loops too irregularly to measure (its per-tile share of
  // moving samples scatters where Chromium's is uniform) and it is not
  // Safari, so do not read a phase offset from it.
  type Turn = {
    img: HTMLImageElement;
    anim: string;
    still: string;
    loop: number;
    blob: Blob | null;
    url: string | null;
    ready: boolean;
    onScreen: boolean;
    playing: boolean;
    paused: boolean;
  };
  type Clock = { epoch: number | null; timer: number; queued: number; waiting: Set<Turn> };

  // How long a clock with nothing running yet waits for the rest of the
  // on-screen turnarounds to arrive before starting the ones it has.
  const GATHER_MS = 1200;

  const turns = new Map<Element, Turn>();
  const clocks = new Map<number, Clock>();

  for (const img of document.querySelectorAll<HTMLImageElement>(".project-anim")) {
    const { anim, still } = img.dataset;
    if (!anim || !still) continue;
    turns.set(img, {
      img,
      anim,
      still,
      loop: Number(img.dataset.loop) || 0,
      blob: null,
      url: null,
      ready: false,
      onScreen: false,
      playing: false,
      paused: false,
    });
    img.src = still; // park it — nothing animates until a beat admits it
  }

  const clockFor = (loop: number) => {
    let c = clocks.get(loop);
    if (!c) clocks.set(loop, (c = { epoch: null, timer: 0, queued: 0, waiting: new Set() }));
    return c;
  };

  function start(t: Turn) {
    if (t.url) URL.revokeObjectURL(t.url); // that image is loaded; its URL is spent
    t.url = t.blob ? URL.createObjectURL(t.blob) : null;
    t.img.src = t.url ?? t.anim; // no blob (the fetch failed): the file itself
    t.playing = true;
  }

  function beat(c: Clock) {
    c.timer = 0;
    if (c.epoch === null) c.epoch = performance.now();
    for (const t of c.waiting) start(t);
    c.waiting.clear();
  }

  /** Put a turnaround in line for the next beat of its clock, if it is idle,
   *  on screen and holding its bytes. */
  function enqueue(t: Turn) {
    if (t.playing || t.paused || !t.ready || !t.onScreen) return;
    const c = clockFor(t.loop);
    c.waiting.add(t);

    if (!t.loop) return beat(c); // no readable loop length: nothing to sync to

    if (c.epoch === null) {
      // Nothing is running on this clock yet, so the first beat is ours to
      // place: hold it until every turnaround already on screen has its bytes
      // — but no longer than GATHER_MS, so one slow fetch cannot keep the
      // whole page still.
      const pending = [...turns.values()].some(
        (o) => o.loop === t.loop && o.onScreen && !o.ready && !o.paused,
      );
      if (!c.queued) c.queued = performance.now();
      clearTimeout(c.timer);
      const wait = pending ? Math.max(0, c.queued + GATHER_MS - performance.now()) : 0;
      c.timer = window.setTimeout(() => beat(c), wait);
      return;
    }

    if (c.timer) return; // a beat is already booked; it will take this one too
    const into = (performance.now() - c.epoch) % t.loop;
    c.timer = window.setTimeout(() => beat(c), t.loop - into);
  }

  if (!reduce && turns.size > 0) {
    // Fetch on approach. This is the moment loading="lazy" would have picked,
    // moved into script because the src the browser now lazy-loads is the
    // still: the animation is fetched here and admitted later, on a beat.
    const approaching = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          approaching.unobserve(e.target);
          const t = turns.get(e.target);
          if (!t) continue;
          fetch(t.anim)
            .then((r) => (r.ok ? r.blob() : null))
            .catch(() => null)
            .then((blob) => {
              t.blob = blob; // null: it gets admitted from its own URL instead
              t.ready = true;
              enqueue(t);
            });
        }
      },
      { rootMargin: "200% 0px" },
    );

    const onScreen = new IntersectionObserver((entries) => {
      for (const e of entries) {
        const t = turns.get(e.target);
        if (!t) continue;
        t.onScreen = e.isIntersecting;
        if (t.onScreen) enqueue(t);
      }
    });

    for (const t of turns.values()) {
      approaching.observe(t.img);
      onScreen.observe(t.img);
    }
  }

  // The pause control (WCAG 2.2.2). Pausing parks the turnaround back on its
  // still; playing again asks for the next beat, so one that is resumed comes
  // back in step with the rest rather than on its own.
  for (const t of turns.values()) {
    onActivate(t.img, () => {
      if (reduce) {
        // Nothing is synchronised under reduced motion — the set starts
        // parked, and playing one is a deliberate act.
        t.playing = !t.playing;
        t.img.src = t.playing ? t.anim : t.still;
        return;
      }
      if (!t.paused && !t.playing) return; // still loading; nothing to toggle yet
      t.paused = !t.paused;
      if (t.paused) {
        clockFor(t.loop).waiting.delete(t);
        t.img.src = t.still;
        t.playing = false;
      } else {
        enqueue(t);
      }
    });
  }
</script>

<style>
  .project-header {
    padding-top: 6.5rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--color-line);
  }


  /* Max-width and page gutter come from .editorial (global.css). */
  .project-header__inner {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--color-ink-muted);
    transition: color 0.2s;
  }

  .back-link:hover { color: var(--color-ink); }

  .project-header__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-bottom: 0.875rem;
  }

  .project-header__title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 6vw, 6.5rem);
    font-weight: 400;
    line-height: 1.0;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    margin-bottom: 1.125rem;
  }

  .project-header__desc {
    max-width: 55ch;
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-ink-soft);
  }

  /* ── Showreel ────────────────────────────────────────────── */
  /* Same container as the gallery, so the reel spans the full editorial
     width above it. Its padding-bottom stays 0: the gallery's own 3rem top
     padding is what separates the two, which keeps this working whether or
     not the project has gallery items. */
  .project-reel { padding-block: 3rem 0; }

  /* ── Gallery ─────────────────────────────────────────────── */
  .project-images { padding-block: 3rem 0; }

  .project-images__grid {
    display: grid;
    grid-template-columns: 1fr;
    align-items: start;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .project-images__grid { grid-template-columns: repeat(2, 1fr); }
    .project-image-wrap.span-2 { grid-column: span 2; }
  }

  .project-image-wrap { overflow: hidden; background: var(--color-paper-alt); }

  /* Transparent media (the animated-WebP turnarounds) get no tint of their
     own — the page's own background is what should show through the alpha, so
     this keeps working if the palette ever changes. */
  .project-image-wrap.is-alpha { background: transparent; }

  .project-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: grayscale(12%);
    transition: filter 0.5s;
  }

  .project-image:hover { filter: grayscale(0%); }

  .project-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    cursor: pointer;
  }

  .project-video:focus-visible,
  .project-anim:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }

  /* Transparent turnarounds: contain, not cover — a cropped 3D turnaround
     loses the model's extremities as it spins — and no grayscale wash, which
     would fight the renders' own colour. Nothing is painted behind them
     (.is-alpha on the wrap), so the page background shows through the alpha. */
  .project-anim {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    cursor: pointer;
  }

  /* ── YouTube ─────────────────────────────────────────────── */
  .project-yt {
    padding-block: 1rem 0;
    display: grid;
    gap: 1rem;
  }

  /* ── Footer ──────────────────────────────────────────────── */
  .project-footer {
    padding-block: 2.5rem 0;
    border-top: 1px solid var(--color-line);
    margin-top: 3.5rem;
  }
</style>
