---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DisciplineSwitch from "../../components/shared/DisciplineSwitch.astro";
import YouTubeEmbed from "../../components/productions/YouTubeEmbed.astro";
import ProjectReel from "../../components/productions/ProjectReel.astro";
import EpisodeSlideshow from "../../components/productions/EpisodeSlideshow.astro";
import { projects } from "../../data/three-d";
import { srcset } from "../../lib/responsive";
import { gallery, reel, type GalleryItem } from "../../lib/media";
import { abs, breadcrumbs, personRef } from "../../lib/schema";

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props;

const isPV = project.category === "product-visualisation";
const backHref = isPV ? "/productions/product-visualisation" : "/productions";
// Names the TAB it returns to, not the section: the pill and that tab's chip are
// the two ends of one morph, and "Graphic Design & 3D" named neither. Cased as
// prose, not as the chip — the pill reads as a sentence, so only "Back" leads.
const backLabel = isPV ? "product visualisation" : "productions";
// Pairs the back pill with the sub-nav chip for the exact TAB it returns to.
// SubNav composes its names per tab, not per section, so that switching tabs
// inside the bar pairs nothing and stays a cut — which means this has to name
// the tab too. Naming the section instead would pair a Product Visualisation
// project with the Productions chip and fly the pill to the wrong tab.
const backMorph = `section-chip-${isPV ? "product-visualisation" : "productions"}`;

const origin = Astro.site ?? Astro.url.origin;
const pageUrl = abs(origin, `/productions/${project.slug}/`);

const schema = [
  breadcrumbs(origin, [
    { name: "Home", path: "/" },
    { name: "Graphic Design & 3D", path: "/productions/" },
    ...(isPV
      ? [{ name: "Product Visualisation", path: "/productions/product-visualisation/" }]
      : []),
    { name: project.title, path: `/productions/${project.slug}/` },
  ]),
  {
    "@type": "VisualArtwork",
    "@id": `${pageUrl}#artwork`,
    url: pageUrl,
    name: project.title,
    description: project.description,
    image: abs(origin, project.cover),
    keywords: project.tags.join(", "),
    artMedium: "Digital",
    creator: personRef(origin),
  },
];

const items = gallery(project);
const showreel = reel(project);

// Layout driven by each item's aspect ratio: landscape media span the full
// editorial width, squarish/portrait media flow two-up. When a run of two-up
// items has odd length, its first item is promoted to full width so no row is
// left half-empty — unless it's a portrait, which would grow far too tall.
const ratio = (it: GalleryItem) => (it.w && it.h ? it.w / it.h : 1);
const spans = items.map((it) => (ratio(it) >= 1.25 ? 2 : 1));
let runStart = -1;
for (let i = 0; i <= spans.length; i++) {
  if (i < spans.length && spans[i] === 1) {
    if (runStart < 0) runStart = i;
    continue;
  }
  if (runStart >= 0) {
    if ((i - runStart) % 2 === 1 && ratio(items[runStart]) >= 0.9) spans[runStart] = 2;
    runStart = -1;
  }
}

// A gallery made only of turnarounds becomes a spotlight instead: one large
// stage and a picker of stills. Ten ~1 MB animations spinning at once was a
// long scroll of small, equal tiles where no single model could be studied,
// and the page decoded all of them; the stage shows one at full size and
// decodes only that one. A gallery that mixes turnarounds with stills keeps
// the grid (and the sync script below), since it has no single subject.
const spotlight = items.length > 1 && items.every((it) => it.kind === "animation");

// A reel is a 16:9 hero under an already-tall header, so it pushes the whole
// grid below the fold: the poster becomes the LCP candidate and nothing in the
// gallery is worth eager-loading (these turnarounds run ~1 MB each). A project
// with galleryFirst flips that: the gallery leads and the reel waits its turn.
const reelLeads = !!showreel && !project.galleryFirst;
const galleryEager = reelLeads ? 0 : 2;

const SIZES_FULL = "(min-width: 1280px) 1104px, 100vw";
const SIZES_HALF = "(min-width: 1280px) 544px, (min-width: 640px) 50vw, 100vw";
// The band's player takes 30% of the editorial width beside its heading.
const SIZES_BAND = "(min-width: 1280px) 331px, (min-width: 768px) 30vw, 100vw";

// A video with a heading renders as a band (heading left, player right);
// the rest stack full-width after the gallery as before.
const idCard = !!(project.identityCard && project.specs);

// The heading splits a long title into the name and a small line under it.
// The subtitle has to be the end of the title, so the h1 still reads as the
// whole title (the separator survives as sr-only text) and nothing is lost.
const sub = project.subtitle && project.title.endsWith(project.subtitle) ? project.subtitle : undefined;
const titleName = sub ? project.title.slice(0, -sub.length).replace(/[\s:–—-]+$/, "") : project.title;

// On a card page the first band video moves into the card's right-hand panel,
// so nothing about the project sits between the title and the card. A project
// with an episodes slideshow already has that panel filled, so keeps its band.
const allBands = (project.youtube ?? []).filter((v) => v.heading);
const panelVideo = idCard && !project.episodes ? allBands[0] : undefined;
const ytBands = allBands.filter((v) => v !== panelVideo);
const ytPlain = (project.youtube ?? []).filter((v) => !v.heading);
// The panel is the 1fr column of the card's 1.15fr/1fr grid, less its padding.
const SIZES_PANEL = "(min-width: 1280px) 410px, (min-width: 900px) 40vw, 100vw";
---

<BaseLayout title={project.title} description={project.description} image={project.cover} schema={schema}>

  <!-- The way out, pinned like the nav. A project is a long scroll of
       artwork and the header carrying this pill is gone within one screen,
       which left no route back but the browser's own. Fixed rather than
       sticky because sticky is bounded by its parent, and every parent here
       is the header itself. -->
  <div class="back-rail">
    <div class="editorial">
      <a href={backHref} class="back-pill" style={`--back-morph:${backMorph}`}>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <polyline points="10,2 4,8 10,14" stroke="currentColor" stroke-width="1.25"
            stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Back to {backLabel}
      </a>
    </div>
  </div>

  <!-- Header -->
  <section class:list={["project-header", idCard && "project-header--card"]}>
    <div class="project-header__inner editorial">
      <div>
        <div class="project-header__meta">
          {project.tags.map((t) => <span class="label">{t}</span>)}
        </div>
        <h1 class="project-header__title">
          {titleName}{sub && <><span class="sr-only">: </span><span class="project-header__sub">{sub}</span></>}
        </h1>
        {!idCard && <p class="project-header__desc">{project.description}</p>}
        {project.credits?.map((c) => (
          <p class="project-credit">
            <span class="label">{c.role}</span>
            {c.imdb ? (
              <a
                class="project-credit__link"
                href={c.imdb}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span class="project-credit__name">{c.name}</span>
                <span class="sr-only">on IMDb</span>
                <svg width="38" height="19" viewBox="0 0 38 19" aria-hidden="true">
                  <rect width="38" height="19" rx="3" fill="#F5C518"/>
                  <text x="19" y="14" text-anchor="middle" font-family="Arial, Helvetica, sans-serif"
                    font-size="11" font-weight="900" fill="#000">IMDb</text>
                </svg>
              </a>
            ) : (
              <span class="project-credit__name">{c.name}</span>
            )}
          </p>
        ))}
      </div>
    </div>
  </section>

  <!-- Episode band: a YouTube video with a heading leads the page, above the
       project's own media — it is the finished piece the rest breaks down.
       Click-to-load like every facade: nothing third-party until play. -->
  {ytBands.map((v) => (
    <section class="project-yt-band editorial" aria-labelledby={`yt-band-${v.id}`}>
      <div class="project-yt-band__text">
        <h2 class="project-yt-band__title" id={`yt-band-${v.id}`}>{v.heading}</h2>
        <div class="project-yt-band__actions">
          <a
            class="yt-action"
            href={`https://www.youtube.com/watch?v=${v.id}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            Watch on YouTube
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M4 2h6v6M10 2 2 10" stroke="currentColor" stroke-width="1.25"
                stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </div>
      <div class="project-yt-band__player">
        <YouTubeEmbed slug={project.slug} id={v.id} title={v.title} sizes={SIZES_BAND} minimal />
      </div>
    </section>
  ))}

  <!-- The identity card, and the project's media inside it. With an identity
       card the gallery and the showreel sit IN the card, under the facts, so
       the page reads as one object; without one both wrappers are
       display: contents and the sections lay out on the page as they always
       have. One copy of the media markup serves both cases. -->
  <div class:list={["project-card-band", idCard && "editorial"]}>
    <div class:list={[idCard ? "project-id-card" : "project-card-plain"]}>
        {idCard && project.specs && (
          <>
            <p class="project-id__lede">{project.description}</p>
            <div class="project-id-wrap">
            <dl class="project-id" aria-label={`${project.title} at a glance`}>
              {project.specs.map((s) => (
                <div class:list={["project-id__row", s.href && "project-id__row--link"]}>
                  <dt class="project-id__key">{s.label}</dt>
                  <dd class="project-id__value">
                    {s.href ? (
                      <a href={s.href} target="_blank" rel="noopener noreferrer">
                        {s.value}
                        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                          <path d="M4 2h6v6M10 2 2 10" stroke="currentColor" stroke-width="1.25"
                            stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </a>
                    ) : s.value}
                  </dd>
                </div>
              ))}
            </dl>
            {panelVideo && (
            <div class="project-id__aside">
              <p class="label project-id__aside-label">{panelVideo.heading}</p>
              <div class="project-id__player">
                <YouTubeEmbed slug={project.slug} id={panelVideo.id} title={panelVideo.title} sizes={SIZES_PANEL} minimal />
              </div>
              <a
                class="yt-action project-id__cta"
                href={`https://www.youtube.com/watch?v=${panelVideo.id}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                Watch on YouTube
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M4 2h6v6M10 2 2 10" stroke="currentColor" stroke-width="1.25"
                    stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>
            )}
            {(project.watchLink || project.episodes) && (
            <div class="project-id__aside">
            {project.episodes?.label && (
              <p class="label project-id__aside-label">{project.episodes.label}</p>
            )}
            {project.episodes && (
              <EpisodeSlideshow
                slug={project.slug}
                series={project.title}
                playlist={project.episodes.playlist}
                episodes={project.episodes.list}
              />
            )}
            {project.watchLink && (
              <a
                class="yt-action project-id__watch"
                href={project.watchLink.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg class="project-id__yt" width="20" height="14" viewBox="0 0 20 14" aria-hidden="true">
                  <rect width="20" height="14" rx="3.5" fill="var(--color-brick)"/>
                  <polygon points="8,4 13.5,7 8,10" fill="var(--color-paper)"/>
                </svg>
                {project.watchLink.label}
                <span class="sr-only">on YouTube</span>
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M4 2h6v6M10 2 2 10" stroke="currentColor" stroke-width="1.25"
                    stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            )}
            </div>
            )}
            </div>
          </>
        )}

  <!-- Showreel: the project's edited piece, click-to-play so its soundtrack
       survives and nothing but the poster is fetched up front — unless the
       project opts into reelAutoplay, which starts it muted on open.
       Rendered here, or after the gallery when the project sets galleryFirst. -->
  {reelLeads && (
    <section class="project-reel editorial" aria-label={`${project.title} — ${project.reelCaption ?? "showreel"}`}>
      <ProjectReel
        title={project.title}
        webm={showreel.webm}
        mp4={showreel.mp4}
        poster={showreel.poster}
        w={showreel.w}
        h={showreel.h}
        caption={project.reelCaption ?? "Showreel"}
        muted={project.reelMuted}
        autoplay={project.reelAutoplay}
      />
    </section>
  )}

  <!-- Gallery: images + self-hosted video loops, derived from the project folder -->
  {items.length > 0 && (
    <section class="project-images editorial" aria-label="Project media">
      {spotlight && (
        <div class="spot">
          <div class="spot__bar">
          <button type="button" class="spot__nudge" data-dir="-1" aria-label="Scroll previews left">
            <svg viewBox="0 0 10 12" aria-hidden="true"><path d="M8 1 2 6l6 5z" /></svg>
          </button>
          <div class="spot__thumbs" role="group" aria-label={`Choose a ${project.title} animation`}>
            {items.map((item, i) => item.kind === "animation" && (
              <button
                type="button"
                class="spot__thumb"
                aria-pressed={i === 0 ? "true" : "false"}
                data-anim={item.src}
                data-still={item.poster}
                data-alt={`${project.title} — animation ${i + 1}`}
              >
                <img src={item.poster} alt="" width={item.w ?? 1024} height={item.h ?? 1024} loading="lazy" decoding="async" />
                <span class="sr-only">{`Show animation ${i + 1}`}</span>
              </button>
            ))}
          </div>
          <button type="button" class="spot__nudge" data-dir="1" aria-label="Scroll previews right">
            <svg viewBox="0 0 10 12" aria-hidden="true"><path d="M2 1l6 5-6 5z" /></svg>
          </button>
          </div>
          {/* The stage keeps the grid's pause control: a <button> around the
              image, toggling it between the animation and its still. Its src
              is the first animation in the markup, so with JS off the stage
              still spins and only the picker is inert. */}
          <div class="spot__stage">
            <button type="button" class="project-media-btn" aria-pressed="false">
              <img
                class="spot__anim"
                src={items[0].src}
                data-anim={items[0].src}
                data-still={items[0].kind === "animation" ? items[0].poster : undefined}
                alt={`${project.title} — animation 1`}
                width={items[0].w ?? 1024}
                height={items[0].h ?? 1024}
                loading={galleryEager ? "eager" : "lazy"}
                decoding="async"
              />
              <span class="sr-only">Pause this animation</span>
            </button>
          </div>
        </div>
      )}
      {!spotlight && (
      <div class="project-images__grid">
        {items.map((item, i) => {
          const span2 = spans[i] === 2;
          const ar = item.w && item.h ? `aspect-ratio:${item.w}/${item.h}` : undefined;
          return (
            <div class:list={["project-image-wrap", span2 && "span-2", item.kind === "animation" && "is-alpha"]} style={ar}>
              {item.kind === "video" ? (
                /* The pause control is a real <button> wrapping the media, not
                   tabindex on the media itself. An <img>/<video> given
                   tabindex="0" is focusable but keeps its img/video role, so a
                   screen reader announces a graphic rather than something
                   operable — which is why the operating instruction had been
                   pushed into aria-label, i.e. into the element's NAME. A
                   button carries the role and the keyboard behaviour natively,
                   the media keeps its alt as content, and aria-pressed carries
                   the state. The button sits INSIDE .project-image-wrap, so
                   the grid still has exactly one child per item. */
                <button type="button" class="project-media-btn" aria-pressed="false">
                  <video
                    class="project-video"
                    autoplay
                    muted
                    loop
                    playsinline
                    preload="metadata"
                    poster={item.poster}
                    width={item.w}
                    height={item.h}
                    aria-hidden="true"
                  >
                    {item.webm && <source src={item.webm} type="video/webm" />}
                    {item.mp4 && <source src={item.mp4} type="video/mp4" />}
                  </video>
                  <span class="sr-only">{`Pause ${project.title} — animation ${i + 1}`}</span>
                </button>
              ) : item.kind === "animation" ? (
                <button type="button" class="project-media-btn" aria-pressed="false">
                  <img
                    class="project-anim"
                    src={item.src}
                    data-still={item.poster}
                    data-anim={item.src}
                    data-loop={item.loopMs}
                    alt={`${project.title} — animation ${i + 1}`}
                    width={item.w ?? 1024}
                    height={item.h ?? 1024}
                    loading={i < galleryEager ? "eager" : "lazy"}
                    fetchpriority={i === 0 && !reelLeads ? "high" : undefined}
                    decoding="async"
                  />
                  <span class="sr-only">Pause this animation</span>
                </button>
              ) : (
                <img
                  src={item.src}
                  srcset={srcset(item.src)}
                  sizes={span2 ? SIZES_FULL : SIZES_HALF}
                  alt={`${project.title} — view ${i + 1}`}
                  width={item.w ?? 1600}
                  height={item.h ?? 900}
                  loading={i < galleryEager ? "eager" : "lazy"}
                  fetchpriority={i === 0 && !reelLeads ? "high" : undefined}
                  decoding="async"
                  class="project-image"
                />
              )}
            </div>
          );
        })}
      </div>
      )}
    </section>
  )}

  {showreel && !reelLeads && (
    <section class="project-reel editorial" aria-label={`${project.title} — ${project.reelCaption ?? "showreel"}`}>
      <ProjectReel
        title={project.title}
        webm={showreel.webm}
        mp4={showreel.mp4}
        poster={showreel.poster}
        w={showreel.w}
        h={showreel.h}
        caption={project.reelCaption ?? "Showreel"}
        muted={project.reelMuted}
        autoplay={project.reelAutoplay}
        belowFold
      />
    </section>
  )}
    </div>
  </div>

  <!-- YouTube (turnarounds, breakdowns) — click-to-load facade, nothing
       third-party is requested until the visitor presses play -->
  {ytPlain.length > 0 && (
    <section class="project-yt editorial" aria-label="Project videos">
      {ytPlain.map((v) => (
        <YouTubeEmbed slug={project.slug} id={v.id} title={v.title} />
      ))}
    </section>
  )}

  <!-- Footer -->
  <!-- Footer: the way back and the way across, on one line. -->
  <DisciplineSwitch label="Also explore" href="/photography" name="Photography">
    <a slot="lead" href={backHref} class="back-link">{isPV ? "← Back to product visualisation" : "← All projects"}</a>
  </DisciplineSwitch>
</BaseLayout>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  /**
   * Wire a media item's pause button. The control is the <button> wrapping the
   * media, so Enter and Space are the browser's job — a native button already
   * fires `click` for both, and the hand-rolled keydown this replaced would now
   * fire a second time on top of it. `toggle` returns the new paused state,
   * which is mirrored to aria-pressed so the button announces where it is.
   */
  function onActivate(media: Element, toggle: () => boolean) {
    const btn = media.closest<HTMLButtonElement>(".project-media-btn");
    if (!btn) return;
    btn.addEventListener("click", () => {
      btn.setAttribute("aria-pressed", String(toggle()));
    });
  }

  /** Reflect a starting state that the server could not know (reduced motion). */
  function setPressed(media: Element, pressed: boolean) {
    media.closest(".project-media-btn")?.setAttribute("aria-pressed", String(pressed));
  }

  // Looping videos: honour prefers-reduced-motion (start paused) and give
  // everyone a pause control — the wrapping button toggles playback (WCAG
  // 2.2.2). No native `controls` under reduced motion any more: the video now
  // sits inside a <button>, and putting the browser's own control strip inside
  // another control nests interactive elements, so a click on the scrubber
  // would toggle the button too.
  for (const v of document.querySelectorAll<HTMLVideoElement>(".project-video")) {
    if (reduce) {
      v.removeAttribute("autoplay");
      v.pause();
      setPressed(v, true);
    }
    onActivate(v, () => {
      if (v.paused) v.play(); else v.pause();
      return v.paused;
    });
  }

  // ── Spotlight (a gallery of turnarounds only) ───────────────────────
  // One animation on the stage at a time, so none of the beat machinery
  // below applies: there is nothing beside it to be in phase with. Pause is
  // the same swap to the still as in the grid, and it is a mode rather than
  // a per-model state — picking another model while paused shows its still,
  // and under reduced motion the stage starts paused.
  const stage = document.querySelector<HTMLImageElement>(".spot__anim");
  if (stage) {
    const thumbs = [...document.querySelectorAll<HTMLButtonElement>(".spot__thumb")];
    let anim = stage.dataset.anim ?? stage.src;
    let still = stage.dataset.still ?? anim;
    let paused = reduce;
    let pick = 0;

    // The still goes up first and the animation replaces it once its bytes
    // are in. The still is already cached — it is that model's thumbnail —
    // so a pick answers at once, instead of leaving the previous model on
    // the stage (or a blank one) while a megabyte downloads.
    const show = () => {
      const mine = ++pick;
      stage.src = still;
      if (paused) return;
      const pre = new Image();
      pre.onload = pre.onerror = () => {
        if (mine === pick && !paused) stage.src = anim;
      };
      pre.src = anim;
    };

    if (paused) {
      stage.src = still;
      setPressed(stage, true);
    }

    onActivate(stage, () => {
      paused = !paused;
      show();
      return paused;
    });

    // The picker is one horizontal strip. With a mouse, the wheel scrolls it
    // sideways while the bar is hovered and the triangles page it; on touch
    // it is a plain native swipe and the triangles are hidden by CSS. Over
    // the bar the wheel belongs to the strip outright — at either end it
    // stops there rather than handing on to the page, so the gallery never
    // lurches away under the pointer mid-browse. Moving off the bar gives
    // the wheel back to the page.
    //
    // Every scroll the page drives — wheel, triangles, revealing a picked
    // thumb — runs through one glide: each frame closes a fixed fraction of
    // the remaining distance (exponential decay, frame-rate independent), so
    // it leaves fast and settles with no visible end. A notched wheel used to
    // jump 100px a click; now consecutive clicks feed the same target, and
    // any new input retargets the glide mid-flight instead of queueing
    // behind it. The position is kept here rather than read back from
    // scrollLeft, which an engine may round to whole pixels and stall the
    // last few frames on. A horizontal trackpad swipe is left to the
    // browser: it already carries its own momentum, and smoothing it again
    // only makes it lag the fingers. Under reduced motion every glide is a jump.
    const strip = document.querySelector<HTMLElement>(".spot__thumbs");
    const nudges = [...document.querySelectorAll<HTMLButtonElement>(".spot__nudge")];
    let reveal = (_: HTMLElement) => {};
    if (strip) {
      const FADE = 40;
      const maxScroll = () => strip.scrollWidth - strip.clientWidth;
      let pos = 0;
      let target = 0;
      let tau = 0;
      let raf = 0;
      let last = 0;

      const stop = () => {
        cancelAnimationFrame(raf);
        raf = 0;
      };
      const step = (now: number) => {
        const dt = Math.min(64, now - last);
        last = now;
        pos += (target - pos) * (1 - Math.exp(-dt / tau));
        if (Math.abs(target - pos) < 0.5) pos = target;
        strip.scrollLeft = pos;
        raf = pos === target ? 0 : requestAnimationFrame(step);
      };
      // tau is the decay constant in ms: ~5 tau to settle. Short for the
      // wheel, which arrives in small steps; longer for a page or a reveal,
      // which travel further and read as a deliberate move.
      const glide = (to: number, t: number) => {
        if (!raf) pos = target = strip.scrollLeft;
        target = Math.max(0, Math.min(maxScroll(), to));
        tau = t;
        if (reduce) {
          strip.scrollLeft = pos = target;
          return;
        }
        if (!raf) {
          last = performance.now();
          raf = requestAnimationFrame(step);
        }
      };

      // Both edges fade out over the thumbs hidden beyond them, and each fade
      // grows with the distance left to scroll that way — none at an end, the
      // full FADE once a thumb's width is out of view — so the strip shows
      // which way there is more and the fade itself moves with the scroll.
      const ends = () => {
        const max = maxScroll();
        const left = strip.scrollLeft;
        strip.style.setProperty("--fade-start", `${Math.min(FADE, Math.max(0, left))}px`);
        strip.style.setProperty("--fade-end", `${Math.min(FADE, Math.max(0, max - left))}px`);
        for (const n of nudges) {
          n.disabled = n.dataset.dir === "-1" ? left <= 0 : left >= max - 1;
        }
      };

      const bar = strip.closest<HTMLElement>(".spot__bar") ?? strip;
      bar.addEventListener("wheel", (e) => {
        if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) {
          stop();
          return;
        }
        e.preventDefault();
        const d = e.deltaMode === 1 ? e.deltaY * 40 : e.deltaY;
        const from = raf ? target : strip.scrollLeft;
        if ((d < 0 && from <= 0) || (d > 0 && from >= maxScroll() - 1)) return;
        glide(from + d, 70);
      }, { passive: false });
      strip.addEventListener("pointerdown", stop);

      // A page is the whole thumbs in view less one, landing on a thumb's
      // edge, so the last one shown stays on screen as the anchor for where
      // the strip went.
      for (const n of nudges) {
        n.addEventListener("click", () => {
          const [a, b] = thumbs;
          const pitch = b ? b.offsetLeft - a.offsetLeft : strip.clientWidth;
          const page = Math.max(1, Math.floor(strip.clientWidth / pitch) - 1) * pitch;
          const from = raf ? target : strip.scrollLeft;
          glide(Math.round(from / pitch) * pitch + Number(n.dataset.dir) * page, 110);
        });
      }

      // A thumb picked while half out of view glides fully in, centred.
      reveal = (el) => {
        const s = strip.getBoundingClientRect();
        const r = el.getBoundingClientRect();
        if (r.left >= s.left && r.right <= s.right) return;
        glide(strip.scrollLeft + r.left - s.left - (s.width - r.width) / 2, 110);
      };

      strip.addEventListener("scroll", ends, { passive: true });
      addEventListener("resize", ends);
      ends();
    }

    for (const b of thumbs) {
      b.addEventListener("click", () => {
        reveal(b);
        if (b.getAttribute("aria-pressed") === "true") return;
        anim = b.dataset.anim ?? anim;
        still = b.dataset.still ?? anim;
        stage.alt = b.dataset.alt ?? stage.alt;
        for (const o of thumbs) o.setAttribute("aria-pressed", String(o === b));
        show();
      });
    }
  }

  // ── Animated WebP turnarounds ────────────────────────────────────────
  // Transparent, and holding their last frame — see scripts/gen-anim.mjs.
  // Two things follow from an animated image having no playback API. "Pause"
  // can only mean swapping in the still first frame and back, which is the
  // control at the end of this block. And a loop starts whenever the browser
  // first paints that particular image, so a grid of turnarounds spins in as
  // many phases as it had decode times: encoding the set to one clock
  // (gen-anim.mjs --cadence/--total-ms) made every lap the same length but
  // left the offsets between them exactly where they were.
  //
  // The one moment the page does control is when a loop *begins* — assigning
  // a src whose bytes are already in memory starts that animation at frame 1,
  // now. That is the whole lever, and it cuts one way only: there is no seek,
  // so a latecomer can be brought into step with what is already spinning
  // ONLY by holding it until that set comes round to frame 1 again. "Starts
  // the instant it is seen" and "in phase with its neighbours" cannot both be
  // true of it. Something has to give.
  //
  // What gives is the page-wide phase, because the other choice reads as
  // broken. This used to align every arrival to one clock running since the
  // first beat, which meant a turnaround scrolled into view sat on its still
  // for up to a full lap — 3.3s here, 1.65s on average — while the tiles
  // around it visibly spun. Correct, and indistinguishable from an image that
  // failed to load.
  //
  // So a beat is per *arrival* now, not per lap. A new arrival books one
  // CLUSTER_MS out and everything that becomes ready inside that window rides
  // it, which is what keeps a grid row scrolled into view spinning as one —
  // the comparison the eye actually makes, since a row is two tiles side by
  // side. A row already running keeps the phase it started on, so a long page
  // settles into a few phases rather than one. That is the price of the
  // snap, and it is deliberate: see the CLUSTER_MS note below before trading
  // it back.
  //
  // Three things it depends on, each measured across the three engines rather
  // than assumed:
  //   • Admit from a Blob, as a freshly minted object URL. Re-assigning a URL
  //     the engine has already loaded restarts the loop in Chromium and
  //     WebKit, but rejoins it mid-lap in Firefox — which is the spec, not a
  //     bug: animated images sharing an absolute URL are "rendered
  //     synchronized to the same timeline as a group", and a later one "jumps
  //     to the point in the animation cycle that is currently being
  //     displayed" (HTML Standard, Rendering § Images). A URL the engine has
  //     never seen has no group to join, so it starts at frame 1 everywhere.
  //     Hence neither of the two usual tricks: clearing and re-setting src is
  //     the Firefox case above (bugzilla 210001, 594771), and adding
  //     `?` + Math.random() buys the restart by re-downloading a megabyte.
  //   • Admit only what is on screen. Assigning to an off-screen image does
  //     not start its loop — that happens at the first paint — so it would
  //     begin whenever the visitor scrolled to it, in nobody's phase.
  //   • A queued turnaround is only invisible while the wait stays short.
  //     These spend the last ~1.8s of every lap held on the front pose, which
  //     is exactly the still they show while queued, so one waiting to join
  //     looks like one holding — but only for as long as the eye grants it,
  //     and a lap is far longer than that. CLUSTER_MS sits well inside the
  //     hold; the lap-boundary wait it replaced did not.
  //
  // After that an animation is left alone: every engine keeps its clock
  // running while it is scrolled past (Blink catches the frame up on the way
  // back), so phase survives scrolling without any help. With JS off, the
  // markup's own animated src plays, unsynchronised.
  //
  // To re-verify after touching any of this: drive the page with Playwright,
  // screenshot each turnaround every ~100ms, and cross-correlate the tiles'
  // frame-to-frame difference signals — tiles admitted on the same beat peak
  // at lag 0, which is what Chromium and Firefox both measure. Correlate
  // within a cluster, never across the whole page: two rows revealed by
  // separate scrolls are now supposed to differ, so a page-wide figure proves
  // nothing in either direction. Playwright's headless WebKit renders these
  // loops too irregularly to measure (its per-tile share of moving samples
  // scatters where Chromium's is uniform) and it is not Safari, so do not
  // read a phase offset from it.
  type Turn = {
    img: HTMLImageElement;
    anim: string;
    still: string;
    loop: number;
    blob: Blob | null;
    url: string | null;
    ready: boolean;
    onScreen: boolean;
    playing: boolean;
    paused: boolean;
  };
  type Clock = { started: boolean; timer: number; queued: number; waiting: Set<Turn> };

  // How long a clock with nothing running yet waits for the rest of the
  // on-screen turnarounds to arrive before starting the ones it has.
  const GATHER_MS = 1200;

  // And how long a clock that is already running holds a new arrival, so that
  // a row scrolling into view is admitted on one beat rather than two. The
  // ceiling is the eye, not the encoder: this has to stay far enough under
  // the ~1.8s front-pose hold that a queued tile reads as a held one. Raising
  // it towards a lap length buys back page-wide phase and brings back the
  // stall it was written to remove.
  const CLUSTER_MS = 200;

  const turns = new Map<Element, Turn>();
  const clocks = new Map<number, Clock>();

  for (const img of document.querySelectorAll<HTMLImageElement>(".project-anim")) {
    const { anim, still } = img.dataset;
    if (!anim || !still) continue;
    turns.set(img, {
      img,
      anim,
      still,
      loop: Number(img.dataset.loop) || 0,
      blob: null,
      url: null,
      ready: false,
      onScreen: false,
      playing: false,
      paused: false,
    });
    img.src = still; // park it — nothing animates until a beat admits it
  }

  const clockFor = (loop: number) => {
    let c = clocks.get(loop);
    if (!c) clocks.set(loop, (c = { started: false, timer: 0, queued: 0, waiting: new Set() }));
    return c;
  };

  function start(t: Turn) {
    if (t.url) URL.revokeObjectURL(t.url); // that image is loaded; its URL is spent
    t.url = t.blob ? URL.createObjectURL(t.blob) : null;
    t.img.src = t.url ?? t.anim; // no blob (the fetch failed): the file itself
    t.playing = true;
  }

  function beat(c: Clock) {
    c.timer = 0;
    c.started = true;
    for (const t of c.waiting) start(t);
    c.waiting.clear();
  }

  /** Put a turnaround in line for the next beat of its clock, if it is idle,
   *  on screen and holding its bytes. */
  function enqueue(t: Turn) {
    if (t.playing || t.paused || !t.ready || !t.onScreen) return;
    const c = clockFor(t.loop);
    c.waiting.add(t);

    if (!t.loop) return beat(c); // no readable loop length: nothing to sync to

    if (!c.started) {
      // Nothing has run on this clock yet, so the first beat is ours to
      // place: hold it until every turnaround already on screen has its bytes
      // — but no longer than GATHER_MS, so one slow fetch cannot keep the
      // whole page still. Re-booked on every arrival rather than left alone,
      // because `pending` going false is what fires this early.
      const pending = [...turns.values()].some(
        (o) => o.loop === t.loop && o.onScreen && !o.ready && !o.paused,
      );
      if (!c.queued) c.queued = performance.now();
      clearTimeout(c.timer);
      const wait = pending ? Math.max(0, c.queued + GATHER_MS - performance.now()) : 0;
      c.timer = window.setTimeout(() => beat(c), wait);
      return;
    }

    // Already running, so this is a latecomer: it starts on its own beat a
    // moment from now rather than on the running set's, and takes with it
    // whatever else lands inside the window.
    if (c.timer) return; // a beat is already booked; it will take this one too
    c.timer = window.setTimeout(() => beat(c), CLUSTER_MS);
  }

  if (!reduce && turns.size > 0) {
    // Fetch on approach. This is the moment loading="lazy" would have picked,
    // moved into script because the src the browser now lazy-loads is the
    // still: the animation is fetched here and admitted later, on a beat.
    const approaching = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          approaching.unobserve(e.target);
          const t = turns.get(e.target);
          if (!t) continue;
          fetch(t.anim)
            .then((r) => (r.ok ? r.blob() : null))
            .catch(() => null)
            .then((blob) => {
              t.blob = blob; // null: it gets admitted from its own URL instead
              t.ready = true;
              enqueue(t);
            });
        }
      },
      { rootMargin: "200% 0px" },
    );

    const onScreen = new IntersectionObserver((entries) => {
      for (const e of entries) {
        const t = turns.get(e.target);
        if (!t) continue;
        t.onScreen = e.isIntersecting;
        if (t.onScreen) enqueue(t);
      }
    });

    for (const t of turns.values()) {
      approaching.observe(t.img);
      onScreen.observe(t.img);
    }
  }

  // The pause control (WCAG 2.2.2). Pausing parks the turnaround back on its
  // still; playing again asks for the next beat, so a resumed one starts in
  // step with anything resumed alongside it. Not with the set it left — that
  // would mean waiting out a lap for a frame 1 it can no longer be given.
  for (const t of turns.values()) {
    // Under reduced motion the set starts parked, so the buttons start pressed.
    // Rendered here rather than in the markup because the server cannot know
    // the visitor's motion preference — the NAME is static in the HTML, which
    // is what matters; only the state is settled at runtime.
    if (reduce) setPressed(t.img, true);

    onActivate(t.img, () => {
      if (reduce) {
        // Nothing is synchronised under reduced motion — the set starts
        // parked, and playing one is a deliberate act.
        t.playing = !t.playing;
        t.img.src = t.playing ? t.anim : t.still;
        return !t.playing;
      }
      if (!t.paused && !t.playing) return t.paused; // still loading; nothing to toggle yet
      t.paused = !t.paused;
      if (t.paused) {
        clockFor(t.loop).waiting.delete(t);
        t.img.src = t.still;
        t.playing = false;
      } else {
        enqueue(t);
      }
      return t.paused;
    });
  }
</script>

<style>
  /* The pill is out of flow now, so the header reserves its own clearance:
     nav gap + the pill + the gap that used to be the flex row's. Both this
     and the rail read --back-pill-h, which is why the pill below is given a
     DEFINITE height rather than being left to its padding — a header that
     guesses at the pill's height goes wrong the moment the type changes. */
  .back-rail,
  .project-header {
    --back-pill-h: 2.5rem;
    /* The sub-nav's stuck top + the bar's inner padding — see .back-rail. */
    --back-rail-top: calc(4.75rem + 0.4rem);
  }

  .project-header {
    padding-top: calc(var(--back-rail-top) + var(--back-pill-h) + 1.75rem);
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--color-line);
  }

  /* Full-bleed so its inner .editorial lands the pill on the same left edge
     as the header text below it — the gutter is never restated here, it is
     the one .editorial already owns. pointer-events is the .subnav trick:
     the rail spans the viewport and would otherwise swallow every click
     across that strip. */
  /* WHERE THIS SITS, and why it is not a round number. The pill is the
     sub-nav's selected chip after it has flown down, so it sits exactly
     where that chip sits once the bar is stuck: the bar's own sticky
     `top: 4.75rem` plus the 0.4rem of padding inside it (SubNav.astro).
     Move either of those and move this with them.

     It was 6.5rem, which was the header's old top padding rather than a
     position in the chrome — a 40px gap under the nav where the sub-nav
     band has 19px. Aligned to nothing, it read as a pill that had fallen
     too far. This also makes the flight nearly horizontal: the chip
     crosses to the corner instead of dropping to it. */
  .back-rail {
    position: fixed;
    inset-inline: 0;
    top: var(--back-rail-top);
    z-index: 45;
    pointer-events: none;
  }


  /* Max-width and page gutter come from .editorial (global.css). */
  .project-header__inner {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  /* ── The way out, as the chip that brought you here ──────────
     This is the sub-nav's selected chip after it has flown down: same ink
     fill, same paper label, same radius and metrics, so the object that
     left the bar is the object that lands here. Keep the two in step — if
     the chip in SubNav.astro changes shape or size, this changes with it,
     or the morph ends on something that is not quite what set off.

     align-self is load-bearing. .project-header__inner is a flex COLUMN,
     so its default `stretch` would pull this to the full editorial width
     and the pill would read as a banner across the top of the page rather
     than a button in the corner. inline-flex alone does not stop that. */
  .back-pill {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    /* A DEFINITE height, matching what the sub-nav chip actually measures
       (it is a stretched flex item, so its 40px comes from the bar, not
       from type). Two things depend on this: the header's clearance above,
       and the morph — the chip used to arrive 2px taller than it set off
       because the chevron sat on a taller line box than the chip's text. */
    height: var(--back-pill-h);
    /* Tighter on the chevron side: the icon's own bearing makes a symmetric
       1.5rem look inset. */
    padding-inline: 1.15rem 1.5rem;
    border-radius: var(--radius-pill);
    background: var(--color-ink);
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--color-paper);
    text-decoration: none;
    white-space: nowrap;
    /* It now floats over the gallery rather than sitting on paper. The fill
       is opaque, so contrast inside the pill is safe on any crop, but
       without a shadow it reads as pasted onto the artwork instead of
       above it. Deliberately not on the chip, which sits in a frosted bar
       where a cast shadow would be wrong; the morph cross-fades the two. */
    box-shadow: 0 2px 12px rgba(26, 25, 23, 0.18);
    transition: background 0.25s;
  }

  .back-pill:hover { background: var(--color-ink-soft); }

  /* The global :focus-visible ring sets border-radius: 2px, which would
     square the pill off the moment it is tabbed to. Put the pill radius
     back; the ring itself is inherited unchanged. */
  .back-pill:focus-visible { border-radius: var(--radius-pill); }

  /* The landing end of the morph declared on the sub-nav's selected chip
     (SubNav.astro). The name is per tab and comes in as --back-morph, set
     in the frontmatter from the category this project belongs to. A
     productions project page renders no sub-nav, so this pill is the only
     claimant here — which is exactly what lets the round trip work in both
     directions. Adding a sub-nav to this page, or a second element with
