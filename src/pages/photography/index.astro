---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CollectionCard from "../../components/photography/CollectionCard.astro";
import DisciplineSwitch from "../../components/shared/DisciplineSwitch.astro";
import PhotographySubNav from "../../components/photography/PhotographySubNav.astro";
import { collections } from "../../data/photography";
---

<BaseLayout
  title="Photography"
  description="Photography collections by Alexandre Haineaux — landscape, portrait, architecture, and documentary."
>
  <h1 class="sr-only">Photography</h1>

  <div class="subnav-spacer" aria-hidden="true"></div>
  <PhotographySubNav active="collections" />

  <!-- Collections grid -->
  <section class="collections-section editorial" aria-label="Photography collections">
    <div class="collections-grid">
      {collections.map((collection, i) => (
        <CollectionCard collection={collection} eager={i < 2} />
      ))}
    </div>
  </section>

  <DisciplineSwitch
    label="Also explore"
    href="/productions"
    name="Graphic Design & 3D"
  />
</BaseLayout>

<style>
  .subnav-spacer { height: 5.5rem; }

  .collections-section { padding-block: 3rem 0; }

  .collections-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
  }

  @media (min-width: 640px) {
    .collections-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 3rem 2rem;
    }
  }
</style>
