---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CollectionCard from "../../components/photography/CollectionCard.astro";
import ProjectCard from "../../components/productions/ProjectCard.astro";
import DisciplineSwitch from "../../components/shared/DisciplineSwitch.astro";
import PhotographySubNav from "../../components/photography/PhotographySubNav.astro";
import { collections } from "../../data/photography";

// One column on a phone, two from 640px, capped by the editorial measure.
const CARD_SIZES = "(min-width: 1280px) 570px, (min-width: 640px) 46vw, 100vw";
---

<BaseLayout
  title="Photography"
  description="Photography collections by Alexandre Haineaux — landscape, portrait, Luxembourgish Art and Design, and documentary."
>
  <h1 class="sr-only">Photography</h1>

  <div class="subnav-spacer" aria-hidden="true"></div>
  <PhotographySubNav active="collections" />

  <!-- Collections grid -->
  <section class="collections-section editorial" aria-label="Photography collections">
    <div class="collections-grid">
      {/* A case study (LAD) is a role, not a set of photographs, so it takes
          the Graphic Design & 3D card rather than the photo card. */}
      {collections.map((collection, i) => collection.caseStudy ? (
        <ProjectCard
          project={{
            slug: collection.slug,
            title: collection.title,
            cover: collection.cover,
            tags: collection.caseStudy.tags,
          }}
          href={`/photography/${collection.slug}`}
          alt={collection.caseStudy.coverAlt}
          sizes={CARD_SIZES}
          eager={i < 2}
        />
      ) : (
        <CollectionCard collection={collection} eager={i < 2} />
      ))}
    </div>
  </section>

  <DisciplineSwitch
    label="Also explore"
    href="/productions"
    name="Graphic Design & 3D"
  />
</BaseLayout>

<style>
  .subnav-spacer { height: 5.5rem; }

  .collections-section { padding-block: 3rem 0; }

  .collections-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
  }

  @media (min-width: 640px) {
    .collections-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 3rem 2rem;
    }
  }
</style>
