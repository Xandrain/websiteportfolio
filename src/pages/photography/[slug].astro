---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Lightbox from "../../components/photography/Lightbox.astro";
import DisciplineSwitch from "../../components/shared/DisciplineSwitch.astro";
import { collections } from "../../data/photography";
import { SITE } from "../../consts";
import { dims, srcset } from "../../lib/responsive";
import { abs, breadcrumbs, personRef } from "../../lib/schema";

export function getStaticPaths() {
  return collections.map((c) => ({ params: { slug: c.slug }, props: { collection: c } }));
}

const { collection } = Astro.props;

const origin = Astro.site ?? Astro.url.origin;
const pageUrl = abs(origin, `/photography/${collection.slug}/`);
const legalUrl = abs(origin, "/legal/");

// A case study is a write-up of a role, laid out as a project page (the
// identity card, UPDATING.md §7f) instead of a gallery.
const cs = collection.caseStudy;

const crumbs = breadcrumbs(origin, [
  { name: "Home", path: "/" },
  { name: "Photography", path: "/photography/" },
  { name: collection.title, path: `/photography/${collection.slug}/` },
]);

// ImageGallery with per-photo license/acquireLicensePage/creditText — the
// fields behind Google Images' "Licensable" badge. Every photo carries the
// copyright notice and points buyers (and strays) back to /legal#licensing.
// Not for a case study: its images show other people's artworks, which this
// site has no business offering a licence for.
const schema = cs ? [
  crumbs,
  {
    "@type": "CreativeWork",
    "@id": `${pageUrl}#work`,
    url: pageUrl,
    name: collection.title,
    description: collection.description,
    image: abs(origin, collection.cover),
    author: personRef(origin),
  },
] : [
  crumbs,
  {
    "@type": "ImageGallery",
    "@id": `${pageUrl}#gallery`,
    url: pageUrl,
    name: collection.title,
    description: collection.description,
    author: personRef(origin),
    associatedMedia: collection.photos.map((photo) => {
      const d = dims(photo.src);
      return {
        "@type": "ImageObject",
        contentUrl: abs(origin, photo.src),
        caption: photo.alt,
        ...(d ? { width: d.w, height: d.h } : {}),
        creator: { "@type": "Person", name: SITE.name },
        creditText: SITE.name,
        copyrightNotice: `© ${SITE.name}`,
        license: legalUrl,
        acquireLicensePage: `${legalUrl}#licensing`,
      };
    }),
  },
];

// As on a project page: a long title keeps only its name at display size and
// the rest becomes a small spaced line. The subtitle must be the end of the
// title, so the h1 still reads as the whole title.
const sub = cs?.subtitle && collection.title.endsWith(cs.subtitle) ? cs.subtitle : undefined;
const titleName = sub ? collection.title.slice(0, -sub.length).replace(/[\s:–—-]+$/, "") : collection.title;

// Role images: two-up inside the card from 900px, full card width below it.
const SIZES_ROLE = "(min-width: 1280px) 488px, (min-width: 900px) calc(50vw - 7rem), calc(100vw - 6rem)";
---

<BaseLayout
  title={collection.title}
  description={collection.description}
  image={collection.cover}
  schema={schema}
>
  <!-- Inside a collection the Collections/Gallery bar is gone and this is
       the only chrome: one way out, pinned like the nav so a long scroll of
       photographs never strands the visitor. Fixed rather than sticky —
       sticky is bounded by its parent, and that parent is the header. It
       says "Collections" because that is the chip it flies from and back
       to, and the two have to read as one object. -->
  <div class="back-rail">
    <div class="editorial">
      <a href="/photography" class="back-pill">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <polyline points="10,2 4,8 10,14" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Back to collections
      </a>
    </div>
  </div>

  {cs ? (
    <>
      {/* Case study: the project page's identity card (productions/[slug].astro,
          UPDATING.md §7f) — tags and title above one card holding everything
          else. The card's class names match that page's on purpose; keep the
          two in step. */}
      <section class="collection-header collection-header--card">
        <div class="collection-header__inner editorial">
          <div>
            <div class="collection-header__meta">
              {cs.tags.map((t) => <span class="label">{t}</span>)}
            </div>
            <h1 class="case-title">
              {titleName}{sub && <><span class="sr-only"> — </span><span class="case-title__sub">{sub}</span></>}
            </h1>
          </div>
        </div>
      </section>

      <div class="project-card-band editorial">
        <div
          class:list={["project-id-card", cs.accent && "project-id-card--accent"]}
          style={cs.accent ? `--case-accent: ${cs.accent}` : undefined}
        >
          {cs.logo ? (
            <div class="case-lede">
              <img
                src={cs.logo.src}
                srcset={srcset(cs.logo.src)}
                sizes="4rem"
                alt={cs.logo.alt}
                width={dims(cs.logo.src)?.w ?? 512}
                height={dims(cs.logo.src)?.h ?? 512}
                decoding="async"
                class="case-lede__logo"
              />
              <p class="project-id__lede">{collection.description}</p>
            </div>
          ) : (
            <p class="project-id__lede">{collection.description}</p>
          )}

          <div class="project-id-wrap">
            <dl class="project-id" aria-label={`${cs.subtitle ?? collection.title} at a glance`}>
              {cs.specs.map((s) => (
                <div class:list={["project-id__row", s.href && "project-id__row--link"]}>
                  <dt class="project-id__key">{s.label}</dt>
                  <dd class="project-id__value">
                    {s.href ? (
                      <a href={s.href} target="_blank" rel="noopener noreferrer">
                        {s.value}
                        <span class="sr-only">(opens in a new tab)</span>
                        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                          <path d="M4 2h6v6M10 2 2 10" stroke="currentColor" stroke-width="1.25"
                            stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </a>
                    ) : s.value}
                  </dd>
                </div>
              ))}
            </dl>

            <section class="project-id__aside" aria-labelledby="case-about">
              <h2 id="case-about" class="label project-id__aside-label">{cs.about.heading}</h2>
              {cs.about.text.map((t) => <p class="case-about__text">{t}</p>)}
            </section>
          </div>

          {cs.loop && (
            /* The project page's looping clip (.project-video in
               productions/[slug].astro): a real <button> around a muted video,
               so the pause control has a role and a name (WCAG 2.2.2). */
            <button type="button" class="case-loop" aria-pressed="false">
              <video
                class="case-loop__video"
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
                poster={cs.loop.poster}
                width={dims(cs.loop.poster)?.w ?? 1920}
                height={dims(cs.loop.poster)?.h ?? 1080}
                aria-hidden="true"
              >
                <source src={cs.loop.webm} type="video/webm" />
                <source src={cs.loop.mp4} type="video/mp4" />
              </video>
              <span class="sr-only">{`Pause ${cs.loop.label} animation`}</span>
            </button>
          )}

          <section class="case-role" aria-labelledby="case-role">
            <h2 id="case-role" class="case-role__heading">{cs.role.heading}</h2>
            <div class="case-role__grid">
              {cs.role.blocks.map((b) => {
                const d = dims(b.image.src);
                return (
                  <div class="case-block">
                    <img
                      src={b.image.src}
                      srcset={srcset(b.image.src)}
                      sizes={SIZES_ROLE}
                      alt={b.image.alt}
                      width={d?.w ?? 1600}
                      height={d?.h ?? 1000}
                      loading="lazy"
                      decoding="async"
                      class="case-block__img"
                    />
                    <h3 class="case-block__title">{b.title}</h3>
                    <p class="case-block__text">{b.text}</p>
                  </div>
                );
              })}
            </div>
          </section>

          <div class="case-closing">
            <p class="case-closing__text">{cs.closing.text}</p>
            <a class="case-cta" href={cs.closing.href} target="_blank" rel="noopener noreferrer">
              {cs.closing.label}
              <span class="sr-only">(opens in a new tab)</span>
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path d="M4 2h6v6M10 2 2 10" stroke="currentColor" stroke-width="1.25"
                  stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>
        </div>
      </div>

      {/* The way back and the way across, on one line — as on a project page. */}
      <DisciplineSwitch label="Also explore" href="/productions" name="Graphic Design & 3D">
        <a slot="lead" href="/photography" class="back-link">← All collections</a>
      </DisciplineSwitch>
    </>
  ) : (
    <>
      {/* Header */}
      <section class="collection-header">
        <div class="collection-header__inner editorial">
          <div>
            <div class="collection-header__meta">
              <span class="label">{collection.category}</span>
              <span class="label">{collection.photos.length} images</span>
            </div>
            <h1 class="collection-header__title">{collection.title}</h1>
            <p class="collection-header__desc">{collection.description}</p>
          </div>
        </div>
      </section>

      {/* Gallery with lightbox */}
      <section class="gallery-section editorial" aria-labelledby="gallery-title">
        <h2 id="gallery-title" class="sr-only">Photo gallery</h2>
        <Lightbox photos={collection.photos} collectionTitle={collection.title} />
      </section>

      {/* Cross-navigation */}
      <div class="collection-footer editorial">
        <a href="/photography" class="back-link">← All collections</a>
      </div>

      <DisciplineSwitch label="Also explore" href="/productions" name="Graphic Design & 3D" />
    </>
  )}
</BaseLayout>

<script>
  // The case study's looping clip: starts paused under prefers-reduced-motion,
  // and the wrapping button toggles playback for everyone (WCAG 2.2.2). Same
  // behaviour as .project-video on the project page.
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  for (const btn of document.querySelectorAll<HTMLButtonElement>(".case-loop")) {
    const v = btn.querySelector("video");
    if (!v) continue;
    if (reduce) {
      v.removeAttribute("autoplay");
      v.pause();
      btn.setAttribute("aria-pressed", "true");
    }
    btn.addEventListener("click", () => {
      if (v.paused) v.play(); else v.pause();
      btn.setAttribute("aria-pressed", String(v.paused));
    });
  }
</script>

<style>
  /* Clearance for the fixed pill: nav gap + pill + the gap that used to be
     the flex row's. Both this and the rail read --back-pill-h, which is why
     the pill is given a DEFINITE height below. */
  .back-rail,
  .collection-header {
    --back-pill-h: 2.5rem;
    /* The sub-nav's stuck top + the bar's inner padding — see .back-rail. */
    --back-rail-top: calc(4.75rem + 0.4rem);
  }

  .collection-header {
    padding-top: calc(var(--back-rail-top) + var(--back-pill-h) + 1.75rem);
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--color-line);
  }

  /* Full-bleed, so its inner .editorial lands the pill on the same left edge
     as the header text — the gutter is never restated, it is the one
     .editorial owns. pointer-events is the .subnav trick: the rail spans the
     viewport and would otherwise swallow clicks across that strip. */
  /* WHERE THIS SITS, and why it is not a round number. The pill is the
     sub-nav's selected chip after it has flown down, so it sits exactly
     where that chip sits once the bar is stuck: the bar's own sticky
     `top: 4.75rem` plus the 0.4rem of padding inside it (SubNav.astro).
     Move either of those and move this with them.

     It was 6.5rem, which was the header's old top padding rather than a
     position in the chrome — a 40px gap under the nav where the sub-nav
     band has 19px. Aligned to nothing, it read as a pill that had fallen
     too far. This also makes the flight nearly horizontal: the chip
     crosses to the corner instead of dropping to it. */
  .back-rail {
    position: fixed;
    inset-inline: 0;
    top: var(--back-rail-top);
    z-index: 45;
    pointer-events: none;
  }


  /* Max-width and page gutter come from .editorial (global.css). */
  .collection-header__inner {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  /* Same ink pill as the productions project pages, for the same reason —
     a grey text link under a full-bleed header was not reading as the way
     out. Kept in step with .back-pill in productions/[slug].astro and with
     the selected chip in SubNav.astro; the three are one shape.

     This page used to render PhotographySubNav as well, which put the
     selected "Collections" chip on screen right beside this pill and made
     the morph impossible — one object cannot be in two places, and a
     second claimant of the name makes the browser drop every morph on the
     page silently. The bar is gone from a collection now, so this pill is
     the only claimant and the chip can fly into it and back, exactly as on
     the productions side.

     align-self: .collection-header__inner is a flex column, so the default
     stretch would run this pill the full editorial width. */
  .back-pill {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    /* Definite, and equal to what the sub-nav chip measures — the chip is a
       stretched flex item, so its 40px comes from the bar, not from type.
       The header's clearance and both ends of the morph depend on it. */
    height: var(--back-pill-h);
    padding-inline: 1.15rem 1.5rem;
    border-radius: var(--radius-pill);
    background: var(--color-ink);
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--color-paper);
    text-decoration: none;
    white-space: nowrap;
    /* It floats over the photographs now. The fill is opaque so contrast
       inside is safe on any crop, but without a shadow it reads as pasted
       onto the picture rather than above it. Not on the chip, which sits in
       a frosted bar where a cast shadow would be wrong. */
    box-shadow: 0 2px 12px rgba(26, 25, 23, 0.18);
    transition: background 0.25s;
  }

  /* Pairs with the Collections chip in the sub-nav on /photography. Named
     per tab, like the productions pills — see SubNav.astro. */
  .back-pill {
    view-transition-name: section-chip-collections;
  }

  @media (prefers-reduced-motion: reduce) {
    .back-pill { view-transition-name: none; }
  }

  .back-pill:hover { background: var(--color-ink-soft); }

  /* The global :focus-visible ring sets border-radius: 2px; put the pill
     radius back so tabbing to it does not square it off. */
  .back-pill:focus-visible { border-radius: var(--radius-pill); }

  @media (max-width: 480px) {
    .back-rail,
    .collection-header { --back-pill-h: 2.125rem; }

    .back-pill {
      padding-inline: 0.8rem 1rem;
      font-size: 0.8125rem;
    }
  }

  /* Footer cross-link — plain text, not a pill. */
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    text-decoration: none;
    color: var(--color-ink-muted);
    transition: color 0.2s;
  }

  .back-link:hover { color: var(--color-ink); }

  .collection-header__meta {
    display: flex;
    gap: 1.5rem;
    margin-bottom: 0.875rem;
  }

  .collection-header__title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 6vw, 6rem);
    font-weight: 500;
    line-height: 1.0;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin-bottom: 1.125rem;
  }

  .collection-header__desc {
    max-width: 55ch;
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-ink-soft);
  }

  .gallery-section { padding-block: 3rem 0; }

  .collection-footer {
    padding-block: 2.5rem 0;
    border-top: 1px solid var(--color-line);
    margin-top: 3.5rem;
  }

  /* ── Case study ──────────────────────────────────────────────
     The identity card from productions/[slug].astro: the same rules under
     the same names, so a case study reads as a project page. Change one and
     change the other. What is new here is only what a case study adds — the
     title metrics, the About panel's text, the role blocks, the closing. */

  /* The card is its own band after the header, so the header gives up its
     bottom rule and padding: the title sits on the card. */
  .collection-header--card { padding-bottom: 0; border-bottom: 0; }

  /* The project page's title size, not a collection's 6rem display. */
  .case-title {
    font-family: var(--font-display);
    font-size: clamp(2.375rem, 4.4vw, 3.25rem);
    font-weight: 500;
    line-height: 1.0;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin-bottom: 1.125rem;
    text-wrap: balance;
  }

  .case-title__sub {
    display: block;
    margin-top: 0.625rem;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
  }

  @media (max-width: 480px) { .case-title__sub { font-size: 0.71875rem; } }

  .project-card-band { padding-block: 0.75rem 0; }

  .project-id-card {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-top: 0.75rem;
    border-radius: 1.5rem;
    border: 1px solid var(--color-line);
    background:
      linear-gradient(135deg, rgba(26, 25, 23, 0.025) 0%, transparent 55%),
      rgba(250, 250, 248, 0.72);
    box-shadow: 0 8px 48px rgba(26, 25, 23, 0.05), 0 1px 4px rgba(26, 25, 23, 0.04);
    padding: 2rem;
  }

  @media (min-width: 768px) { .project-id-card { padding: 3rem; } }

  @media (max-width: 640px) {
    .project-id-card { padding: 1.5rem 1.25rem; border-radius: 1.25rem; gap: 1.5rem; }
  }

  /* 46ch, not 60: a ch is Figtree's zero, about 1.6 characters of running
     text, so 60ch set 78 a line at 1440. 46ch holds it near 72. */
  .project-id__lede {
    max-width: 46ch;
    margin-inline: auto;
    text-align: center;
    text-wrap: balance;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--color-ink-soft);
  }

  /* The studio's mark in a bubble beside the lede. The pair is centred as a
     group and the text set left against the bubble; sized so two lines of
     lede (2 × 1.0625rem × 1.75) sit level with it. Stacked on a phone, where
     beside it the lede would run to five lines.

     The measure is narrowed while the two sit side by side. `balance`
     shortens the LINES but never the box: at the lede's usual 60ch the box
     ran ~200px past the text, the group was centred on that empty space and
     read as pushed left. CSS cannot shrink a wrapped paragraph's box to its
     longest line, so the box is sized to two balanced lines of this copy
     instead and there is next to no slack to throw the centring off.
     Swept, not chosen: under 22.25em the copy breaks to three lines and the
     group lands ~50px off; from there each 0.25em adds ~2px of offset.
     22.75em is 5px off with ~8px of headroom before a third line, so
     another engine's font metrics cannot tip it over. Tied to the copy: if
     the description changes, re-sweep rather than trusting this number. */
  .case-lede {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
  }

  .case-lede .project-id__lede {
    max-width: 22.75em;
    margin-inline: 0;
    text-align: left;
  }

  .case-lede__logo {
    flex: none;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 2px 12px rgba(26, 25, 23, 0.18);
  }

  @media (max-width: 480px) {
    .case-lede { flex-direction: column; gap: 1rem; }
    .case-lede .project-id__lede { text-align: center; }
  }

  /* Facts left, About right; the rows share out the panel's height, so keep
     every value to one line beside its label. Stacked below 900px. */
  .project-id-wrap {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 900px) {
    .project-id-wrap { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); }
  }

  .project-id {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    min-width: 0;
  }

  .project-id__aside {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    border-radius: 1.75rem;
    border: 1px solid var(--color-line);
    background: rgba(250, 250, 248, 0.62);
    padding: 1.5rem;
  }

  @media (max-width: 640px) { .project-id__aside { padding: 1.25rem; border-radius: 1.25rem; } }

  .project-id__aside-label { text-align: center; }

  .project-id__row {
    flex: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    border-radius: 1rem;
    border: 1px solid var(--color-line);
    background: rgba(250, 250, 248, 0.8);
    padding: 0.75rem 1.25rem;
  }

  .project-id__key {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .project-id__value {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--color-ink);
    text-align: right;
  }

  /* A fact with an `href` links out; its ::after covers the row, so the
     whole pill is the target. */
  .project-id__row--link {
    position: relative;
    transition: border-color 0.25s, box-shadow 0.25s, transform 0.25s;
  }

  .project-id__row--link:hover {
    transform: translateY(-2px);
    border-color: rgba(26, 25, 23, 0.16);
    box-shadow: 0 2px 12px rgba(26, 25, 23, 0.05);
  }

  .project-id__value a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
  }

  .project-id__value a::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .project-id__value a svg { flex: none; color: var(--color-ink-muted); }

  .project-id__value a:focus-visible { box-shadow: none; }
  .project-id__row--link:has(a:focus-visible) {
    box-shadow: 0 0 0 2px var(--color-paper), 0 0 0 4px var(--color-accent-ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-id__row--link:hover { transform: none; }
  }

  @media (max-width: 480px) {
    .project-id__row {
      flex-direction: column;
      align-items: flex-start;
    }

    .project-id__value { text-align: left; }
  }

  .case-about__text {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-ink-soft);
  }

  /* The looping clip. `all: unset` is the button reset the project page uses
     on .project-media-btn; the video's own aspect ratio sizes it. */
  .case-loop {
    all: unset;
    display: block;
    overflow: hidden;
    border-radius: var(--radius-thumb);
