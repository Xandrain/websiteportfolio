---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Lightbox from "../../components/photography/Lightbox.astro";
import DisciplineSwitch from "../../components/shared/DisciplineSwitch.astro";
import PhotographySubNav from "../../components/photography/PhotographySubNav.astro";
import { collections } from "../../data/photography";

export function getStaticPaths() {
  return collections.map((c) => ({ params: { slug: c.slug }, props: { collection: c } }));
}

const { collection } = Astro.props;
---

<BaseLayout
  title={collection.title}
  description={collection.description}
  image={collection.cover}
>
  <!-- Back link + header -->
  <section class="collection-header">
    <div class="collection-header__inner">
      <a href="/photography" class="back-link">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <polyline points="10,2 4,8 10,14" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Photography
      </a>

      <div>
        <div class="collection-header__meta">
          <span class="label">{collection.category}</span>
          <span class="label">{collection.year}</span>
          <span class="label">{collection.photos.length} images</span>
        </div>
        <h1 class="collection-header__title">{collection.title}</h1>
        <p class="collection-header__desc">{collection.description}</p>
      </div>
    </div>
  </section>

  <PhotographySubNav active="collections" />

  <!-- Gallery with lightbox -->
  <section class="gallery-section" aria-labelledby="gallery-title">
    <h2 id="gallery-title" class="sr-only">Photo gallery</h2>
    <div class="gallery-wrapper">
      <Lightbox photos={collection.photos} collectionTitle={collection.title} />
    </div>
  </section>

  <!-- Cross-navigation -->
  <div class="collection-footer">
    <div class="collection-footer__inner">
      <a href="/photography" class="back-link">← All collections</a>
    </div>
  </div>

  <DisciplineSwitch label="Also explore" href="/productions" name="Graphic Design & 3D" />
</BaseLayout>

<style>
  .collection-header {
    padding-top: 6.5rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--color-line);
  }


  .collection-header__inner {
    max-width: var(--max-width-editorial);
    margin-inline: auto;
    padding-inline: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  @media (min-width: 640px)  { .collection-header__inner { padding-inline: 2rem; } }
  @media (min-width: 1024px) { .collection-header__inner { padding-inline: 3rem; } }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    text-decoration: none;
    color: var(--color-ink-muted);
    transition: color 0.2s;
  }

  .back-link:hover { color: var(--color-ink); }

  .collection-header__meta {
    display: flex;
    gap: 1.5rem;
    margin-bottom: 0.875rem;
  }

  .collection-header__title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 6vw, 6rem);
    font-weight: 400;
    line-height: 1.0;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    margin-bottom: 1.125rem;
  }

  .collection-header__desc {
    max-width: 55ch;
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-ink-soft);
  }

  .gallery-section {
    max-width: var(--max-width-editorial);
    margin-inline: auto;
    padding: 3rem 1.5rem 0;
  }

  @media (min-width: 640px)  { .gallery-section { padding-inline: 2rem; } }
  @media (min-width: 1024px) { .gallery-section { padding-inline: 3rem; } }

  .gallery-wrapper { width: 100%; }

  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border: 0;
  }

  .collection-footer {
    max-width: var(--max-width-editorial);
    margin-inline: auto;
    padding: 2.5rem 1.5rem 0;
    border-top: 1px solid var(--color-line);
    margin-top: 3.5rem;
  }

  @media (min-width: 640px)  { .collection-footer { padding-inline: 2rem; } }
</style>
