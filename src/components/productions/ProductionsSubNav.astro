---
/**
 * Secondary nav for the Graphic Design & 3D section.
 * Two persistent, sticky tabs: Productions · Product Visualisation.
 * Sits just below the fixed main nav pill and stays on screen while scrolling.
 */
import type { ProductionCategory } from "../../data/three-d";

interface Props {
  active: ProductionCategory;
}

const { active } = Astro.props;

const tabs: { key: ProductionCategory; label: string; href: string }[] = [
  { key: "productions", label: "Productions", href: "/productions" },
  { key: "product-visualisation", label: "Product Visualisation", href: "/productions/product-visualisation" },
];
---

<nav class="subnav" aria-label="Graphic Design & 3D categories">
  <div class="subnav__inner">
    {tabs.map((t) => (
      <a
        href={t.href}
        class:list={["subnav__tab", active === t.key && "is-active"]}
        aria-current={active === t.key ? "page" : undefined}
      >
        {t.label}
      </a>
    ))}
  </div>
</nav>

<style>
  .subnav {
    position: sticky;
    top: 4.75rem; /* clear the fixed main-nav pill */
    z-index: 40;
    display: flex;
    justify-content: center;
    padding-inline: 1rem;
    pointer-events: none;
  }

  .subnav__inner {
    pointer-events: auto;
    display: inline-flex;
    gap: 0.3rem;
    padding: 0.4rem;
    border-radius: var(--radius-pill);
    background: rgba(250, 250, 248, 0.8);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow: 0 1px 2px rgba(26, 25, 23, 0.06), inset 0 0 0 1px rgba(26, 25, 23, 0.09);
  }

  .subnav__tab {
    padding: 0.6rem 1.5rem;
    border-radius: var(--radius-pill);
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    letter-spacing: 0.02em;
    color: var(--color-ink-soft);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s, background 0.25s;
  }

  .subnav__tab:hover {
    color: var(--color-accent-ink);
    background: var(--color-accent-wash);
  }

  .subnav__tab.is-active {
    color: var(--color-ink);
    font-weight: 500;
    background: oklch(from #1A1917 l c h / 0.06);
  }

  @media (max-width: 480px) {
    .subnav__tab { padding: 0.5rem 1rem; font-size: 0.8125rem; }
  }
</style>
