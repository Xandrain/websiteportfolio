---
import type { Production } from "../../data/three-d";
import { srcset, dims } from "../../lib/responsive";

interface Props {
  project: Pick<Production, "slug" | "title" | "cover" | "tags">;
  /** True for above-the-fold cards: load eagerly so the LCP image isn't lazy. */
  eager?: boolean;
  /**
   * "overlay" — the cover fills the card and the label fades in on hover.
   * "plate"   — the cover is inset in a tinted plate and the label sits
   *             below it, permanently. Used by the Productions index, where
   *             the credit (role, studio) is the reason to look at all and so
   *             cannot be hidden behind a hover a phone will never fire.
   */
  variant?: "overlay" | "plate";
  /** Ordinal shown on a plate. Omit and the plate carries no number. */
  index?: number;
  /**
   * The three below let the card serve outside /productions — the LAD case
   * study leads the Photography grid with it. Each defaults to what a
   * productions project needs.
   */
  href?: string;
  /** Cover alt. */
  alt?: string;
  /** Cover `sizes`. The default fits the three-column Product Visualisation grid. */
  sizes?: string;
}

const {
  project,
  eager = false,
  variant = "overlay",
  index,
  href = `/productions/${project.slug}`,
  alt = `${project.title} — Graphic Design & 3D project`,
  sizes = "(min-width: 1024px) 380px, (min-width: 640px) 46vw, 100vw",
} = Astro.props;
const d = dims(project.cover);
const meta = project.tags.slice(0, 2).join(" · ");
---

<a
  href={href}
  class:list={["project-card", variant === "plate" && "project-card--plate"]}
  aria-label={project.title}
>
  <div class="project-card__media">
    <img
      src={project.cover}
      srcset={srcset(project.cover)}
      sizes={sizes}
      alt={alt}
      width={d?.w ?? 1600}
      height={d?.h ?? 600}
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : undefined}
      decoding="async"
      class="project-card__img"
    />
    {variant === "overlay" && (
      <div class="project-card__overlay">
        <div class="project-card__meta">{meta}</div>
        <h2 class="project-card__title">{project.title}</h2>
      </div>
    )}
  </div>

  {variant === "plate" && (
    <div class="project-card__caption">
      <div>
        <h2 class="project-card__plate-title">{project.title}</h2>
        <p class="project-card__plate-meta">{meta}</p>
      </div>
      {index !== undefined && (
        <span class="project-card__ordinal">{String(index).padStart(2, "0")}</span>
      )}
    </div>
  )}
</a>

<style>
  .project-card {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  /* Corners are softened to sit with the pill chrome (nav, sub-nav, FAB) that
     floats over this grid — enough curve to read as the same family, well
     short of the pill itself, which on a 4:3 plate would round the render
     away rather than frame it. The scaled, grayscaled <img> and the hover
     scrim are both clipped by the overflow above, so the radius carries. */
  .project-card__media {
    position: relative;
    overflow: hidden;
    background: var(--color-paper-alt);
    aspect-ratio: 4 / 3;
    border-radius: 0.75rem;
  }

  .project-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.04);
    filter: grayscale(20%);
    transition: transform 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                filter    0.6s;
  }

  .project-card:hover .project-card__img {
    transform: scale(1.0);
    filter: grayscale(0%);
  }

  /* Scrim only darkens the bottom third — gone by ~72% up so the
     artwork reads clean; clicks pass through to the <a>.
     Always shown, as on the Productions index: it used to fade in on
     :hover only, so keyboard visitors (and anyone with no pointer over
     the grid) saw untitled renders. Hover keeps the image's own zoom and
     colour lift above. */
  .project-card__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.125rem;
    /* Stops measured, not chosen: at 0.55/22% the 11px category line
       bottomed out at 2.9:1 over the palest renders (Lulu, Chance). The
       binding case is a ~200px card at 640-1024px, where a long title and
       its category both wrap to two lines and the stack climbs ~7.3rem up
       (Natuargua). The stops are in rem, not %, so they follow the TEXT
       rather than the card: held at 0.5 to 7.5rem, they cover that stack on
       a small card without darkening half of every render on a large one.
       Re-measure if a cover, a title or the type changes. */
    background: linear-gradient(
      to top,
      rgba(10, 9, 8, 0.86) 0,
      rgba(10, 9, 8, 0.74) 4.75rem,
      rgba(10, 9, 8, 0.5)  7.5rem,
      rgba(10, 9, 8, 0)    12rem
    );
    pointer-events: none;
  }

  .project-card__meta {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #fff;
    margin-bottom: 0.3rem;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.45);
  }

  .project-card__title {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.375rem;
    font-weight: 400;
    line-height: 1.15;
    color: #fff;
    text-wrap: balance;
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.5);
  }

  /* ── Plate variant ───────────────────────────────────────────── */
  /* The card becomes a tinted plate with the cover inset inside it — the
     margin of plate around the image is what makes a 3D render read as a
     mounted object rather than as a tile bled to the edge of a grid. */
  .project-card--plate {
    background: var(--color-paper-alt);
    border-radius: 0.375rem;
    box-shadow: inset 0 0 0 1px var(--color-line);
    padding: 0.875rem;
    transition: box-shadow 0.3s, background 0.3s;
  }

  .project-card--plate:hover,
  .project-card--plate:focus-visible {
    background: #EFEDE6;
    box-shadow: inset 0 0 0 1px oklch(from #1A1917 l c h / 0.16);
  }

  .project-card--plate .project-card__media {
    border-radius: 0.1875rem;
    background: var(--color-paper);
  }

  .project-card__caption {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.125rem 0.5rem 0.375rem;
  }

  .project-card__plate-title {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.375rem;
    font-weight: 400;
    line-height: 1.2;
    color: var(--color-ink);
    margin: 0;
    text-wrap: balance;
  }

  .project-card__plate-meta {
    margin: 0.5rem 0 0;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: var(--letter-spacing-caps);
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .project-card__ordinal {
    flex: none;
    font-family: var(--font-display);
    font-size: 0.875rem;
    color: var(--color-accent);
  }
</style>
