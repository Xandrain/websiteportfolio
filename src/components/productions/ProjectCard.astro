---
import type { Production } from "../../data/three-d";
import { srcset } from "../../lib/responsive";

interface Props {
  project: Production;
  featured?: boolean;
  /** True for above-the-fold cards: load eagerly so the LCP image isn't lazy. */
  eager?: boolean;
}

const { project, featured = false, eager = false } = Astro.props;
---

<a
  href={`/productions/${project.slug}`}
  class:list={["project-card", featured && "project-card--featured"]}
  aria-label={project.title}
>
  <div class="project-card__media">
    <img
      src={project.cover}
      srcset={srcset(project.cover)}
      sizes="(min-width: 1024px) 380px, (min-width: 640px) 46vw, 100vw"
      alt={`${project.title} — Graphic Design & 3D project`}
      width="1600"
      height={featured ? "900" : "600"}
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : undefined}
      decoding="async"
      class="project-card__img"
    />
    <div class="project-card__overlay">
      <div class="project-card__meta">
        {[String(project.year), ...project.tags.slice(0, 1)].join(" · ")}
      </div>
      <h2 class:list={["project-card__title", featured && "project-card__title--lg"]}>
        {project.title}
      </h2>
    </div>
  </div>
</a>

<style>
  .project-card {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .project-card__media {
    position: relative;
    overflow: hidden;
    background: var(--color-paper-alt);
    aspect-ratio: 4 / 3;
  }

  .project-card--featured .project-card__media {
    aspect-ratio: 16 / 9;
  }

  .project-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.04);
    filter: grayscale(20%);
    transition: transform 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                filter    0.6s;
  }

  .project-card:hover .project-card__img {
    transform: scale(1.0);
    filter: grayscale(0%);
  }

  /* Scrim only darkens the bottom third — gone by ~72% up so the
     artwork reads clean; clicks pass through to the <a>. */
  .project-card__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.125rem;
    background: linear-gradient(
      to top,
      rgba(10, 9, 8, 0.82) 0%,
      rgba(10, 9, 8, 0.55) 22%,
      rgba(10, 9, 8, 0.15) 48%,
      rgba(10, 9, 8, 0)    72%
    );
    opacity: 0;
    transition: opacity 0.25s cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
  }

  .project-card:hover .project-card__overlay {
    opacity: 1;
  }

  .project-card__meta {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.82);
    margin-bottom: 0.3rem;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.45);
    transform: translateY(7px);
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .project-card__title {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.375rem;
    font-weight: 400;
    line-height: 1.15;
    color: #fff;
    text-wrap: balance;
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.5);
    transform: translateY(7px);
    /* 30ms stagger: title lands just after the meta line */
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1) 0.03s;
  }

  .project-card__title--lg {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
  }

  .project-card:hover .project-card__meta,
  .project-card:hover .project-card__title {
    transform: translateY(0);
  }

  /* Touch devices have no hover: keep the label permanently visible. */
  @media (hover: none) {
    .project-card__overlay { opacity: 1; }
    .project-card__meta,
    .project-card__title { transform: none; }
  }
</style>
