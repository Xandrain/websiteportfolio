---
import type { Photo } from "../../data/photography";
import { srcset, dims } from "../../lib/responsive";

interface Props {
  photos: Photo[];
  collectionTitle: string;
}

const { photos, collectionTitle } = Astro.props;
---

<!-- Gallery grid -->
<ul
  class="photo-gallery"
  id="photo-gallery"
  role="list"
  aria-label={`${collectionTitle} — photo gallery`}
>
  {photos.map((photo, i) => {
    const d = dims(photo.src);
    return (
      <li class="gallery-cell">
        <button
          class="gallery-item"
          data-index={i}
          aria-label={`Open photo ${i + 1}: ${photo.alt}`}
        >
          <img
            src={photo.src}
            srcset={srcset(photo.src)}
            sizes="(min-width: 1280px) 380px, (min-width: 769px) 32vw, (min-width: 481px) 50vw, 100vw"
            alt={photo.alt}
            width={d?.w ?? 1600}
            height={d?.h ?? 1067}
            loading={i < 3 ? "eager" : "lazy"}
            fetchpriority={i === 0 ? "high" : undefined}
            decoding="async"
            class="gallery-item__img"
          />
        </button>
      </li>
    );
  })}
</ul>

<!-- Lightbox dialog -->
<dialog id="lightbox" class="lightbox" aria-label="Photo lightbox">
  <div class="lightbox__inner">
    <button class="lightbox__close" id="lb-close" aria-label="Close lightbox">
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
        <line x1="1" y1="1" x2="17" y2="17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        <line x1="17" y1="1" x2="1" y2="17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>

    <button class="lightbox__nav lightbox__nav--prev" id="lb-prev" aria-label="Previous photo">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <polyline points="13,3 6,10 13,17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    <figure class="lightbox__figure">
      <img id="lb-img" src="" alt="" class="lightbox__img" />
      <figcaption id="lb-caption" class="lightbox__caption" aria-live="polite"></figcaption>
    </figure>

    <button class="lightbox__nav lightbox__nav--next" id="lb-next" aria-label="Next photo">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <polyline points="7,3 14,10 7,17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    <div class="lightbox__counter">
      <span id="lb-current">1</span>
      <span class="lightbox__counter-sep">/</span>
      <span id="lb-total">{photos.length}</span>
    </div>
  </div>
</dialog>

<script>
  const gallery = document.getElementById("photo-gallery") as HTMLElement;
  const dialog  = document.getElementById("lightbox") as HTMLDialogElement;

  if (!gallery || !dialog) throw new Error("Lightbox: missing DOM elements");

  const inner   = dialog.querySelector(".lightbox__inner") as HTMLElement;
  const lbImg   = document.getElementById("lb-img") as HTMLImageElement;
  const lbCap   = document.getElementById("lb-caption") as HTMLElement;
  const lbCurr  = document.getElementById("lb-current") as HTMLElement;
  const lbTotal = document.getElementById("lb-total") as HTMLElement;
  const btnClose = document.getElementById("lb-close") as HTMLButtonElement;
  const btnPrev  = document.getElementById("lb-prev")  as HTMLButtonElement;
  const btnNext  = document.getElementById("lb-next")  as HTMLButtonElement;

  // The rendered gallery <img>s already carry src / srcset / alt — read them
  // from the DOM instead of shipping a second copy of the list as JSON.
  const photos = [...gallery.querySelectorAll<HTMLImageElement>(".gallery-item__img")]
    .map((img) => ({
      src: img.getAttribute("src") ?? "",
      srcset: img.getAttribute("srcset") ?? "",
      alt: img.alt,
    }));

  let current = 0;

  // Warm the browser cache for a neighbouring photo so prev/next feels
  // instant instead of waiting on the network.
  function preload(index: number) {
    const p = photos[(index + photos.length) % photos.length];
    const img = new Image();
    if (p.srcset) {
      img.sizes = "90vw";
      img.srcset = p.srcset;
    }
    img.src = p.src;
  }

  function show(index: number) {
    current = (index + photos.length) % photos.length;
    const p = photos[current];
    lbImg.sizes = "90vw";
    lbImg.srcset = p.srcset ?? "";
    lbImg.src = p.src;
    lbImg.alt = p.alt;
    lbCap.textContent = p.alt;
    lbCurr.textContent = String(current + 1);
    lbTotal.textContent = String(photos.length);
    btnPrev.disabled = photos.length <= 1;
    btnNext.disabled = photos.length <= 1;
    preload(current + 1);
    preload(current - 1);
  }

  function open(index: number) {
    show(index);
    dialog.showModal();
    document.body.style.overflow = "hidden";
  }

  function close() {
    dialog.close();
  }

  // Authoritative cleanup: the native <dialog> can close via the Escape key
  // without ever calling close(), so restore body scroll on the close event —
  // it fires for the button, backdrop, and Escape alike.
  dialog.addEventListener("close", () => {
    document.body.style.overflow = "";
  });

  // Open on gallery item click
  gallery.addEventListener("click", (e) => {
    const btn = (e.target as Element).closest<HTMLButtonElement>(".gallery-item");
    if (!btn) return;
    open(Number(btn.dataset.index ?? 0));
  });

  btnClose.addEventListener("click", close);
  btnPrev.addEventListener("click", () => show(current - 1));
  btnNext.addEventListener("click", () => show(current + 1));

  // Close on backdrop click. The inner wrapper fills the dialog, so a click that
  // lands on the dialog itself or on the padded area around the figure (the
  // inner element, not the image or a control) counts as a backdrop dismiss.
  dialog.addEventListener("click", (e) => {
    if (e.target === dialog || e.target === inner) close();
  });

  // Keyboard navigation
  dialog.addEventListener("keydown", (e) => {
    if (e.key === "ArrowLeft")  { show(current - 1); return; }
    if (e.key === "ArrowRight") { show(current + 1); return; }
  });
</script>

<style>
  /* ── Gallery — ratio-preserving masonry (CSS columns, zero JS) ─
     Each photo keeps its native aspect ratio instead of being cropped
     square; the width/height attributes reserve the space, so the
     column layout doesn't shift as images load. */
  .photo-gallery {
    columns: 3;
    column-gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (max-width: 768px)  { .photo-gallery { columns: 2; } }
  @media (max-width: 480px)  { .photo-gallery { columns: 1; } }

  .gallery-cell {
    display: block;
    break-inside: avoid;
    margin-bottom: 0.5rem;
  }

  .gallery-item {
    all: unset;
    display: block;
    position: relative;
    cursor: zoom-in;
    overflow: hidden;
    background: var(--color-paper-alt);
    width: 100%;
  }

  .gallery-item__img {
    width: 100%;
    height: auto;
    display: block;
    transform: scale(1.03);
    transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                filter    0.4s;
    filter: grayscale(12%);
  }

  .gallery-item:hover .gallery-item__img {
    transform: scale(1.0);
    filter: grayscale(0%);
  }

  .gallery-item:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }

  /* ── Lightbox dialog ────────────────────────────────────────── */
  .lightbox {
    all: unset;
    position: fixed;
    inset: 0;
    z-index: 999;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(8, 7, 6, 0.92);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    animation: lb-in 0.3s ease both;
    width: 100%;
    height: 100%;
  }

  .lightbox:not([open]) { display: none; }

  @keyframes lb-in {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  .lightbox::backdrop { display: none; }

  .lightbox__inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: 3rem 1rem;
  }

  .lightbox__figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    max-width: min(90vw, 1100px);
    max-height: 80dvh;
  }

  .lightbox__img {
    display: block;
    max-width: 100%;
    max-height: 78dvh;
    width: auto;
    height: auto;
    object-fit: contain;
    animation: img-in 0.3s ease both;
  }

  @keyframes img-in {
    from { opacity: 0; transform: scale(0.98); }
    to   { opacity: 1; transform: scale(1); }
  }

  .lightbox__caption {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: rgba(255,255,255,0.45);
    letter-spacing: 0.03em;
    text-align: center;
  }

  .lightbox__close {
    all: unset;
    cursor: pointer;
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    color: rgba(255,255,255,0.65);
    transition: color 0.2s, background 0.2s;
  }

  .lightbox__close:hover {
    color: #fff;
    background: rgba(255,255,255,0.1);
  }

  .lightbox__nav {
    all: unset;
    cursor: pointer;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 2.75rem;
    height: 2.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    color: rgba(255,255,255,0.55);
    transition: color 0.2s, background 0.2s;
  }

  .lightbox__nav:hover  {
    color: #fff;
    background: rgba(255,255,255,0.1);
  }

  .lightbox__nav:disabled { opacity: 0.2; pointer-events: none; }

  .lightbox__nav--prev { left: 1.25rem; }
  .lightbox__nav--next { right: 1.25rem; }

  .lightbox__counter {
    position: absolute;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    color: rgba(255,255,255,0.40);
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .lightbox__counter-sep { color: rgba(255,255,255,0.20); }
</style>
