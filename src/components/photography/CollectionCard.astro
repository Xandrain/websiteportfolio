---
import type { Collection } from "../../data/photography";
import { srcset } from "../../lib/responsive";

interface Props {
  collection: Collection;
  /** True for above-the-fold cards: load eagerly so the LCP image isn't lazy. */
  eager?: boolean;
}
const { collection, eager = false } = Astro.props;
---

<a href={`/photography/${collection.slug}`} class="collection-card" aria-label={collection.title}>
  <div class="collection-card__media">
    <img
      src={collection.cover}
      srcset={srcset(collection.cover)}
      sizes="(min-width: 1280px) 570px, (min-width: 640px) 46vw, 100vw"
      alt={`Cover image for ${collection.title}`}
      width="800"
      height="600"
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : undefined}
      decoding="async"
      class="collection-card__img"
    />
    <div class="collection-card__overlay">
      <div class="collection-card__meta">{collection.category} · {collection.year}</div>
      <h2 class="collection-card__title">{collection.title}</h2>
    </div>
  </div>
</a>

<style>
  .collection-card {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .collection-card__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--color-paper-alt);
  }

  .collection-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.04);
    transition: transform 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                filter    0.6s;
    filter: grayscale(15%);
  }

  .collection-card:hover .collection-card__img {
    transform: scale(1.0);
    filter: grayscale(0%);
  }

  /* Scrim only darkens the bottom third — gone by ~72% up so the
     photograph reads clean; clicks pass through to the <a>. */
  .collection-card__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.125rem;
    background: linear-gradient(
      to top,
      rgba(10, 9, 8, 0.82) 0%,
      rgba(10, 9, 8, 0.55) 22%,
      rgba(10, 9, 8, 0.15) 48%,
      rgba(10, 9, 8, 0)    72%
    );
    opacity: 0;
    transition: opacity 0.25s cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
  }

  .collection-card:hover .collection-card__overlay {
    opacity: 1;
  }

  .collection-card__meta {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.82);
    margin-bottom: 0.3rem;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.45);
    transform: translateY(7px);
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .collection-card__title {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.375rem;
    font-weight: 400;
    line-height: 1.15;
    color: #fff;
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.5);
    transform: translateY(7px);
    /* 30ms stagger: title lands just after the meta line */
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1) 0.03s;
  }

  .collection-card:hover .collection-card__meta,
  .collection-card:hover .collection-card__title {
    transform: translateY(0);
  }

  /* Touch devices have no hover: keep the label permanently visible. */
  @media (hover: none) {
    .collection-card__overlay { opacity: 1; }
    .collection-card__meta,
    .collection-card__title { transform: none; }
  }
</style>
