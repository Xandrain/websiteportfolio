---
import type { Collection } from "../../data/photography";
import { srcset, dims } from "../../lib/responsive";

interface Props {
  collection: Collection;
  /** True for above-the-fold cards: load eagerly so the LCP image isn't lazy. */
  eager?: boolean;
}
const { collection, eager = false } = Astro.props;
const d = dims(collection.cover);
---

<a href={`/photography/${collection.slug}`} class="collection-card" aria-label={collection.title}>
  <div class="collection-card__media">
    <img
      src={collection.cover}
      srcset={srcset(collection.cover)}
      sizes="(min-width: 1280px) 570px, (min-width: 640px) 46vw, 100vw"
      alt={`Cover image for ${collection.title}`}
      width={d?.w ?? 800}
      height={d?.h ?? 600}
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : undefined}
      decoding="async"
      class="collection-card__img"
    />
    <div class="collection-card__overlay">
      <div class="collection-card__meta">{collection.category}</div>
      <h2 class="collection-card__title">{collection.title}</h2>
    </div>
  </div>
</a>

<style>
  .collection-card {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .collection-card__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--color-paper-alt);
  }

  .collection-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.04);
    transition: transform 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                filter    0.6s;
    filter: grayscale(15%);
  }

  .collection-card:hover .collection-card__img {
    transform: scale(1.0);
    filter: grayscale(0%);
  }

  /* Scrim only darkens the bottom third — gone by ~72% up so the
     photograph reads clean; clicks pass through to the <a>.
     Always shown, as on the Productions index: it used to fade in on
     :hover only, so keyboard visitors (and anyone with no pointer over
     the grid) saw a wall of untitled photographs. Hover keeps the image's
     own zoom and colour lift above. */
  .collection-card__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.125rem;
    /* Stops measured, not chosen: at 0.55/22% the 11px category line, which
       sits a fifth of the way up a phone-sized card, bottomed out at 2.9:1
       over the palest crops. Held denser for longer so the whole text stack
       stays on the dark end. Re-measure if a cover or the type changes. */
    background: linear-gradient(
      to top,
      rgba(10, 9, 8, 0.86) 0%,
      rgba(10, 9, 8, 0.72) 28%,
      rgba(10, 9, 8, 0.3)  52%,
      rgba(10, 9, 8, 0)    76%
    );
    pointer-events: none;
  }

  .collection-card__meta {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #fff;
    margin-bottom: 0.3rem;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.45);
  }

  .collection-card__title {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.375rem;
    font-weight: 400;
    line-height: 1.15;
    color: #fff;
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.5);
  }
</style>
