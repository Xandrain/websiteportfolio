---
import type { Collection } from "../../data/photography";
import { srcset } from "../../lib/responsive";

interface Props {
  collection: Collection;
}
const { collection } = Astro.props;
---

<a href={`/photography/${collection.slug}`} class="collection-card" aria-label={collection.title}>
  <div class="collection-card__media">
    <img
      src={collection.cover}
      srcset={srcset(collection.cover)}
      sizes="(min-width: 1280px) 570px, (min-width: 640px) 46vw, 100vw"
      alt={`Cover image for ${collection.title}`}
      width="800"
      height="600"
      loading="lazy"
      decoding="async"
      class="collection-card__img"
    />
    <div class="collection-card__overlay" aria-hidden="true">
      <span class="collection-card__view">View series →</span>
    </div>
  </div>

  <div class="collection-card__meta">
    <div class="collection-card__info">
      <h2 class="collection-card__title">{collection.title}</h2>
      <p class="collection-card__desc">{collection.description}</p>
    </div>
    <div class="collection-card__aside">
      <span class="label">{collection.category}</span>
      <span class="label">{collection.year}</span>
    </div>
  </div>
</a>

<style>
  .collection-card {
    display: block;
    text-decoration: none;
    color: inherit;
    group: true;
  }

  .collection-card__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--color-paper-alt);
  }

  .collection-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.04);
    transition: transform 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                filter    0.6s;
    filter: grayscale(15%);
  }

  .collection-card:hover .collection-card__img {
    transform: scale(1.0);
    filter: grayscale(0%);
  }

  .collection-card__overlay {
    position: absolute;
    inset: 0;
    background: rgba(10, 9, 8, 0);
    display: flex;
    align-items: flex-end;
    padding: 1.25rem;
    transition: background 0.4s;
  }

  .collection-card:hover .collection-card__overlay {
    background: rgba(10, 9, 8, 0.28);
  }

  .collection-card__view {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.35s, transform 0.35s;
  }

  .collection-card:hover .collection-card__view {
    opacity: 1;
    transform: translateY(0);
  }

  .collection-card__meta {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1rem;
  }

  .collection-card__title {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 400;
    color: var(--color-ink);
    margin-bottom: 0.3rem;
    line-height: 1.2;
    transition: color 0.2s;
  }

  .collection-card:hover .collection-card__title { color: var(--color-ink); }

  .collection-card__desc {
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--color-ink-muted);
    max-width: 40ch;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .collection-card__aside {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.25rem;
    flex-shrink: 0;
  }
</style>
