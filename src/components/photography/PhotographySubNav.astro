---
/**
 * Secondary nav for the Photography section: Collections · Gallery.
 * Markup/behaviour live in the shared SubNav component.
 */
import SubNav from "../shared/SubNav.astro";

export type PhotographyView = "collections" | "gallery";

interface Props {
  active: PhotographyView;
}

const { active } = Astro.props;

const tabs = [
  { key: "collections", label: "Collections", href: "/photography" },
  { key: "gallery", label: "Gallery", href: "/photography/gallery" },
];
---

<SubNav
  label="Photography views"
  tabs={tabs}
  active={active}
  morphPrefix="section-chip"
/>
