---
import { SITE, NAV, SOCIAL } from "../consts";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <a href="/" class="site-footer__name">{SITE.name}</a>
      <p class="site-footer__tagline">{SITE.tagline}</p>
    </div>

    <nav class="site-footer__nav" aria-label="Footer navigation">
      <p class="label mb-3">Index</p>
      <ul role="list">
        {NAV.map((item) => (
          <li>
            <a href={item.href} class="site-footer__link">{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-footer__social">
      <p class="label mb-3">Elsewhere</p>
      <ul role="list">
        {SOCIAL.map((item) => (
          <li>
            <a
              href={item.href}
              class="site-footer__link"
              target={item.href.startsWith("http") ? "_blank" : undefined}
              rel={item.href.startsWith("http") ? "noopener noreferrer" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="site-footer__legal">
    <p>© {year} {SITE.name}. All rights reserved.</p>
    <p>{SITE.location}</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 7rem;
    border-top: 1px solid var(--color-line);
  }

  .site-footer__inner {
    max-width: var(--max-width-editorial);
    margin-inline: auto;
    display: grid;
    gap: 3rem;
    padding: 4rem 1.5rem;
  }

  @media (min-width: 640px) {
    .site-footer__inner {
      grid-template-columns: 1.6fr 1fr 1fr;
      padding-inline: 2rem;
    }
  }

  @media (min-width: 1024px) {
    .site-footer__inner { padding-inline: 3rem; }
  }

  .site-footer__name {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 400;
    text-decoration: none;
    color: var(--color-ink);
    letter-spacing: 0.02em;
  }

  /* Emerald signature dot trailing the name, like a full stop. */
  .site-footer__name::after {
    content: "";
    display: inline-block;
    width: 0.3125rem;
    height: 0.3125rem;
    margin-left: 0.28rem;
    vertical-align: 0.12em;
    border-radius: var(--radius-pill);
    background: var(--color-accent);
  }

  /* Section eyebrows pick up the accent (echoes the reference's tinted labels). */
  .site-footer__nav .label,
  .site-footer__social .label {
    color: var(--color-accent-ink);
  }

  .site-footer__tagline {
    margin-top: 0.625rem;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-ink-muted);
    max-width: 28ch;
  }

  .site-footer__nav ul,
  .site-footer__social ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .site-footer__link {
    font-size: 0.875rem;
    color: var(--color-ink-soft);
    text-decoration: none;
    transition: color 0.2s;
  }

  .site-footer__link:hover { color: var(--color-accent-ink); }

  .site-footer__legal {
    max-width: var(--max-width-editorial);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    border-top: 1px solid var(--color-line);
    padding: 1.5rem;
    font-size: 0.75rem;
    color: var(--color-ink-muted);
  }

  @media (min-width: 640px) {
    .site-footer__legal {
      flex-direction: row;
      justify-content: space-between;
      padding-inline: 2rem;
    }
  }

  @media (min-width: 1024px) {
    .site-footer__legal { padding-inline: 3rem; }
  }
</style>
