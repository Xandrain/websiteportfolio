---
import { SITE, NAV } from "../consts";

const path = Astro.url.pathname;
const isActive = (href: string) => path.startsWith(href);
---

<header id="site-header" class="site-header">
  <nav class="site-nav" aria-label="Primary navigation">
    <a href="/" class="site-nav__brand" aria-label={`${SITE.name} — home`}>
      <span class="site-nav__brand-full">{SITE.name}</span>
      <span class="site-nav__brand-initials" aria-hidden="true">
        {SITE.name.split(" ").map((w) => w[0]).join("")}
      </span>
    </a>

    <ul class="site-nav__links" role="list">
      {NAV.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class:list={["site-nav__link", isActive(item.href) && "is-active", item.short && "has-short"]}
          >
            <span class="site-nav__label-full">{item.label}</span>
            {item.short && <span class="site-nav__label-short">{item.short}</span>}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 50;
    display: flex;
    justify-content: center;
    padding: 1.25rem 1rem 0;
    pointer-events: none;
  }

  .site-nav {
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    width: 100%;
    max-width: 42rem;
    border-radius: var(--radius-pill);
    /* The pill now rides over full-bleed imagery (the Productions hero),
       not only over flat paper. Hence more translucency so the picture reads
       through it, and a firmer ring so its edge survives a busy frame. Any
       page putting an image under it must fade that image toward paper at the
       top — the ring alone will not hold against a dark or noisy crop. */
    background: rgba(250, 250, 248, 0.72);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow: 0 1px 2px rgba(26,25,23,0.05), inset 0 0 0 1px rgba(26,25,23,0.12);
    padding: 0.5rem 1.25rem 0.5rem 1.375rem;
    transition: background 0.5s, box-shadow 0.5s;

    /* The other half of the identity morph. The home gate's identity
       card (index.astro) claims this same name, so arriving from the
       gate flies that card up into this pill instead of cutting to it.
       The name must stay unique per page — one pill, one card, never
       both — and the choreography lives in global.css, where the
       document-level ::view-transition pseudo-elements can be reached.
       Reduced motion drops it at the foot of this file. */
    view-transition-name: site-identity;
  }

  .site-nav__brand {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    text-decoration: none;
    color: var(--color-ink);
    transition: opacity 0.25s;
    white-space: nowrap;

    /* The name's landing place. Paired with .gate__name on the home
       gate, so the name flies in as one object instead of fading up
       inside the pill. Under 560px this shows initials rather than the
       full name — the shapes differ, so the pair cross-fades there
       while still travelling together. */
    view-transition-name: site-name;
  }

  .site-nav__brand:hover { opacity: 0.65; }

  /* Full name shown by default; compact initials revealed only on phones. */
  .site-nav__brand-initials { display: none; }

  .site-nav__links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav__link {
    position: relative;
    display: inline-block;
    padding: 0.25rem 0;
    font-size: 0.8125rem;
    font-weight: 400;
    letter-spacing: 0.01em;
    text-decoration: none;
    color: var(--color-ink-soft);
    transition: color 0.2s;
  }

  .site-nav__link::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--color-accent-ink);
    transition: width 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .site-nav__link:hover {
    color: var(--color-accent-ink);
  }

  .site-nav__link.is-active {
    color: var(--color-ink);
  }

  .site-nav__link.is-active::after,
  .site-nav__link:hover::after { width: 100%; }

  /* Short-label swap defaults: full shown, short hidden. */
  .site-nav__label-short { display: none; }

  /* On phones the full name is dropped for small initials, and the three links
     stay a single row centred in the viewport. The brand is taken out of flow
     (absolutely positioned) so the links centre on-screen instead of being
     pushed off-centre by the brand's width. The long label uses its short form. */
  @media (max-width: 560px) {
    .site-nav {
      position: relative;
      justify-content: center;
      gap: 0;
      padding: 0.5rem 1.25rem;
    }

    .site-nav__brand {
      position: absolute;
      left: 1.25rem;
      top: 50%;
      transform: translateY(-50%);
    }

    .site-nav__brand-full { display: none; }
    .site-nav__brand-initials {
      display: inline;
      font-size: 0.9375rem;
      letter-spacing: 0.08em;
    }

    .site-nav__links { gap: 1.375rem; }

    .site-nav__link.has-short .site-nav__label-full { display: none; }
    .site-nav__link.has-short .site-nav__label-short { display: inline; }
  }

  /* Reduced motion softens rather than removes: unpaired from the gate
     card, this pill no longer flies, and the two pages cross-fade
     instead (timings in global.css). */
  @media (prefers-reduced-motion: reduce) {
    .site-nav,
    .site-nav__brand { view-transition-name: none; }
  }
</style>
