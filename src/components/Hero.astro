---
import CTA from "./CTA.astro";

interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  primary?: { href: string; label: string };
  secondary?: { href: string; label: string };
}

const { eyebrow, title, subtitle, primary, secondary } = Astro.props;
---

<section class="mx-auto w-full max-w-editorial px-6 pt-36 sm:px-8 sm:pt-44 lg:px-12">
  <div class="max-w-4xl">
    {eyebrow && <p class="eyebrow mb-7">{eyebrow}</p>}
    <h1
      class="font-display text-6xl leading-[0.95] tracking-tight text-ink sm:text-7xl lg:text-[7.5rem]"
    >
      {title}
    </h1>
    {
      subtitle && (
        <p class="mt-8 max-w-prose text-lg leading-relaxed text-ink-soft">{subtitle}</p>
      )
    }
    {
      (primary || secondary) && (
        <div class="mt-10 flex flex-wrap items-center gap-4">
          {primary && <CTA href={primary.href} label={primary.label} variant="ink" />}
          {secondary && (
            <CTA href={secondary.href} label={secondary.label} variant="ghost" icon="→" />
          )}
        </div>
      )
    }
  </div>
</section>
