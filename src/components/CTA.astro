---
interface Props {
  href: string;
  label: string;
  /** "ink" = solid dark pill; "ghost" = light translucent pill. */
  variant?: "ink" | "ghost";
  /** Trailing icon glyph rendered inside its own circle. */
  icon?: string;
  /** Render as external link (new tab + rel). */
  external?: boolean;
  class?: string;
}

const {
  href,
  label,
  variant = "ink",
  icon = "↗", // ↗
  external = false,
  class: className = "",
} = Astro.props;

const base =
  "group inline-flex w-fit items-center gap-3 rounded-full py-2 pl-6 pr-2 text-sm transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] active:scale-[0.98]";
const variants = {
  ink: "bg-ink text-paper hover:bg-ink-soft",
  ghost: "bg-ink/[0.04] text-ink ring-1 ring-ink/[0.08] hover:bg-ink/[0.07]",
};
const iconTone =
  variant === "ink" ? "bg-paper/15 text-paper" : "bg-accent/[0.16] text-accent-ink";
---

<a
  href={href}
  class:list={[base, variants[variant], className]}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
>
  <span class="tracking-wide">{label}</span>
  <span
    class:list={[
      "flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-sm transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:translate-x-0.5 group-hover:-translate-y-px group-hover:scale-105",
      iconTone,
    ]}
    aria-hidden="true"
  >
    {icon}
  </span>
</a>
