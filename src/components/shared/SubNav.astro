---
/**
 * Sticky pill sub-nav shared by the Photography and Graphic Design & 3D
 * sections. Sits just below the fixed main nav pill and stays on screen while
 * scrolling. The section components (PhotographySubNav, ProductionsSubNav)
 * are thin wrappers that supply the tabs and aria-label.
 */
export interface SubNavTab {
  key: string;
  label: string;
  href: string;
}

interface Props {
  /** Accessible name for the <nav> landmark. */
  label: string;
  tabs: SubNavTab[];
  active: string;
}

const { label, tabs, active } = Astro.props;
---

<nav class="subnav" aria-label={label}>
  <div class="subnav__inner">
    {tabs.map((t) => (
      <a
        href={t.href}
        class:list={["subnav__tab", active === t.key && "is-active"]}
        aria-current={active === t.key ? "page" : undefined}
      >
        {t.label}
      </a>
    ))}
  </div>
</nav>

<script is:inline>
  // Entrance animation only when arriving from outside this section. If the
  // previous page (same-origin referrer) shares the first path segment, the
  // pill was already on screen there — skip the reveal. Runs synchronously
  // during parse, before the animation delay elapses.
  (() => {
    try {
      if (!document.referrer) return;
      const ref = new URL(document.referrer);
      if (
        ref.origin === location.origin &&
        ref.pathname.split("/")[1] === location.pathname.split("/")[1]
      ) {
        document.querySelector(".subnav__inner")?.classList.add("subnav__inner--still");
      }
    } catch {}
  })();
</script>

<script is:inline>
  // Retire the beat on contact. Hovering, tapping or tabbing into the
  // bar means the visitor has found it, and a cue that keeps firing
  // after that is nagging rather than helpful.
  //
  // Listeners go on .subnav__inner, not the <nav>: the wrapper is
  // pointer-events: none outside the pill so it never sees the pointer
  // itself, and pointerenter does not bubble up from the pill either.
  // once:true means each one detaches after firing — nothing stays
  // subscribed for the rest of the visit.
  (() => {
    const inner = document.querySelector(".subnav__inner");
    if (!inner) return;
    const rest = () => inner.classList.add("subnav__inner--rested");
    for (const ev of ["pointerenter", "pointerdown", "focusin"]) {
      inner.addEventListener(ev, rest, { once: true });
    }
  })();
</script>

<style>
  .subnav {
    position: sticky;
    top: 4.75rem; /* clear the fixed main-nav pill */
    z-index: 40;
    display: flex;
    justify-content: center;
    padding-inline: 1rem;
    pointer-events: none;
  }

  .subnav__inner {
    pointer-events: auto;
    display: inline-flex;
    gap: 0.3rem;
    padding: 0.4rem;
    border-radius: var(--radius-pill);
    background: rgba(250, 250, 248, 0.8);
    /* Standard LAST. Lightning CSS treats the last-declared of a
     * prefixed/standard pair as canonical and regenerates prefixes from the
     * build targets; with the -webkit- form last it kept only that, and
     * Firefox does not support the alias — the pill shipped unfrosted there.
     */
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
    box-shadow: 0 1px 2px rgba(26, 25, 23, 0.06), inset 0 0 0 1px rgba(26, 25, 23, 0.09);
  }

  /* Entrance reveal — only when motion is welcome; base state stays visible.

     OVERLAPPING ACTION. The delay is set against the identity morph in
     global.css (480ms), not picked at random: arriving from the home gate,
     the main pill is still flying into place, and this pill dropping in
     underneath it at the same time gave two competing movements and no
     focal point. Starting at 400ms it begins while the morph is on its
     last, barely-moving 100ms — late enough to read as a consequence of
     the pill landing, early enough not to feel like a separate event.
     Retime the morph and retime this with it. */
  @media (prefers-reduced-motion: no-preference) {
    .subnav__inner { animation: subnav-in 0.275s var(--ease-out-expo) 0.4s both; }
    /* Same-section navigation (class set by the inline script): the pill
       persisted from the previous page, so no re-entrance. */
    .subnav__inner.subnav__inner--still { animation: none; }
  }

  @keyframes subnav-in {
    from { opacity: 0; transform: translateY(-10px) scale(0.96); }
    to   { opacity: 1; transform: none; }
  }

  .subnav__tab {
    padding: 0.6rem 1.5rem;
    border-radius: var(--radius-pill);
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    letter-spacing: 0.02em;
    color: var(--color-ink-soft);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s, background 0.25s;
  }

  .subnav__tab:hover {
    color: var(--color-accent-ink);
    background: var(--color-accent-wash);
  }

  /* The selected tab is a solid ink chip, not a wash.

     It used to be `oklch(from #1A1917 l c h / 0.06)` — 1.12:1 against
     the pill it sits in, with a font-weight step as the only other
     signal. The hover rule above is 1.11:1 in luminance but adds a
     hue the pill uses nowhere else AND flips the label to accent ink
     at 6.28:1, so the tab you were NOT on read as the selected one.
     Solid ink at 16.8:1 settles that, and it is the only version that
     survives touch, where hover never fires and the wash was the
     entire state machine.

     Keep hover quieter than this. Restoring a fill/label pair on
     hover that out-weighs a solid chip brings the inversion back. */
  .subnav__tab.is-active {
    color: var(--color-paper);
    font-weight: 500;
    background: var(--color-ink);
  }

  /* ── The beat ──────────────────────────────────────────────
     A slow breath on the selected chip. This bar sits below the
     main pill sharing its paper and its blur, and a page that
     arrives with both already in place gives the eye no reason to
     read the lower one as something operable. One 5% swell
     every six seconds is enough to register as pressable and
     small enough not to pull focus off the work.

     Transform only. It composites, costs no layout, and cannot
     nudge the tab beside it — a width or padding beat would push
     its neighbour around on every cycle. The chip rests for 82%
     of the cycle; the swell itself runs ~1.1s, starting after the
     entrance above has settled.

     It retires on contact (script below): once a visitor has
     found the bar, a cue that keeps firing is just noise.

     Guarded like every animation here, so it never runs under
     `prefers-reduced-motion: reduce` — which includes any machine
     with OS-level animation effects switched off, where the chip
     is simply static. That is the intended fallback, not a bug. */
  @media (prefers-reduced-motion: no-preference) {
    .subnav__tab.is-active { animation: subnav-beat 6s ease-in-out 2.4s infinite; }

    .subnav__inner--rested .subnav__tab.is-active { animation: none; }
  }

  @keyframes subnav-beat {
    0%   { transform: scale(1); }
    9%   { transform: scale(1.05); }
    18%  { transform: scale(1); }
    100% { transform: scale(1); }
  }

  @media (max-width: 480px) {
    .subnav__tab { padding: 0.5rem 1rem; font-size: 0.8125rem; }
  }
</style>
