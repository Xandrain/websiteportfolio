---
/**
 * Sticky pill sub-nav shared by the Photography and Graphic Design & 3D
 * sections. Sits just below the fixed main nav pill and stays on screen while
 * scrolling. The section components (PhotographySubNav, ProductionsSubNav)
 * are thin wrappers that supply the tabs and aria-label.
 */
export interface SubNavTab {
  key: string;
  label: string;
  href: string;
}

interface Props {
  /** Accessible name for the <nav> landmark. */
  label: string;
  tabs: SubNavTab[];
  active: string;
}

const { label, tabs, active } = Astro.props;
---

<nav class="subnav" aria-label={label}>
  <div class="subnav__inner">
    {tabs.map((t) => (
      <a
        href={t.href}
        class:list={["subnav__tab", active === t.key && "is-active"]}
        aria-current={active === t.key ? "page" : undefined}
      >
        {t.label}
      </a>
    ))}
  </div>
</nav>

<script is:inline>
  // Entrance animation only when arriving from outside this section. If the
  // previous page (same-origin referrer) shares the first path segment, the
  // pill was already on screen there — skip the reveal. Runs synchronously
  // during parse, before the animation delay elapses.
  (() => {
    try {
      if (!document.referrer) return;
      const ref = new URL(document.referrer);
      if (
        ref.origin === location.origin &&
        ref.pathname.split("/")[1] === location.pathname.split("/")[1]
      ) {
        document.querySelector(".subnav__inner")?.classList.add("subnav__inner--still");
      }
    } catch {}
  })();
</script>

<style>
  .subnav {
    position: sticky;
    top: 4.75rem; /* clear the fixed main-nav pill */
    z-index: 40;
    display: flex;
    justify-content: center;
    padding-inline: 1rem;
    pointer-events: none;
  }

  .subnav__inner {
    pointer-events: auto;
    display: inline-flex;
    gap: 0.3rem;
    padding: 0.4rem;
    border-radius: var(--radius-pill);
    background: rgba(250, 250, 248, 0.8);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow: 0 1px 2px rgba(26, 25, 23, 0.06), inset 0 0 0 1px rgba(26, 25, 23, 0.09);
  }

  /* Entrance reveal — only when motion is welcome; base state stays visible.

     OVERLAPPING ACTION. The delay is set against the identity morph in
     global.css (480ms), not picked at random: arriving from the home gate,
     the main pill is still flying into place, and this pill dropping in
     underneath it at the same time gave two competing movements and no
     focal point. Starting at 400ms it begins while the morph is on its
     last, barely-moving 100ms — late enough to read as a consequence of
     the pill landing, early enough not to feel like a separate event.
     Retime the morph and retime this with it. */
  @media (prefers-reduced-motion: no-preference) {
    .subnav__inner { animation: subnav-in 0.275s var(--ease-out-expo) 0.4s both; }
    /* Same-section navigation (class set by the inline script): the pill
       persisted from the previous page, so no re-entrance. */
    .subnav__inner.subnav__inner--still { animation: none; }
  }

  @keyframes subnav-in {
    from { opacity: 0; transform: translateY(-10px) scale(0.96); }
    to   { opacity: 1; transform: none; }
  }

  .subnav__tab {
    padding: 0.6rem 1.5rem;
    border-radius: var(--radius-pill);
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    letter-spacing: 0.02em;
    color: var(--color-ink-soft);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s, background 0.25s;
  }

  .subnav__tab:hover {
    color: var(--color-accent-ink);
    background: var(--color-accent-wash);
  }

  .subnav__tab.is-active {
    color: var(--color-ink);
    font-weight: 500;
    background: oklch(from #1A1917 l c h / 0.06);
  }

  @media (max-width: 480px) {
    .subnav__tab { padding: 0.5rem 1rem; font-size: 0.8125rem; }
  }
</style>
