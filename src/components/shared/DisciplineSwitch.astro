---
interface Props {
  label: string;
  href: string;
  name: string;
}

const { label, href, name } = Astro.props;
// Optional `lead` slot: a link set at the row's left, before the first rule
// (a project page's "← All projects"), so the page's way back and its way
// across share one line instead of stacking as two footers.
const hasLead = Astro.slots.has("lead");
---

<aside class:list={["discipline-switch editorial", hasLead && "discipline-switch--lead"]} aria-label="Explore another section">
  <div class="discipline-switch__inner">
    {hasLead && <div class="discipline-switch__lead"><slot name="lead" /></div>}
    <div class="discipline-switch__rule" aria-hidden="true"></div>
    <a href={href} class="discipline-switch__link">
      <span class="discipline-switch__label">{label}</span>
      <span class="discipline-switch__main">
        <span class="discipline-switch__name">{name}</span>
        <span class="discipline-switch__arrow" aria-hidden="true">→</span>
      </span>
    </a>
    <div class="discipline-switch__rule" aria-hidden="true"></div>
  </div>
</aside>

<style>
  /* Max-width and page gutter come from .editorial (global.css). */
  .discipline-switch { padding-block: 5rem 0; }

  .discipline-switch__inner {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  /* With a lead link the row follows straight on from the content above,
     so it does not need the full 5rem of air an index page gives it. */
  /* And the site footer (Footer.astro, margin-top: 7rem) is drawn up to sit
     2.5rem under the row, so the row reads as the footer's own top line
     rather than a stray band floating above it. Local to this variant: the
     footer's 7rem stays right for every other page. */
  .discipline-switch--lead { padding-block: 3.5rem 0; margin-bottom: -4.5rem; }

  .discipline-switch__lead { flex-shrink: 0; }

  .discipline-switch__rule {
    flex: 1;
    height: 1px;
    background: var(--color-line);
  }

  .discipline-switch__link {
    display: inline-flex;
    align-items: center;
    gap: 0.875rem;
    text-decoration: none;
    flex-shrink: 0;
  }

  .discipline-switch__main {
    display: inline-flex;
    align-items: center;
    gap: 0.875rem;
  }

  .discipline-switch__label {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    transition: color 0.25s;
  }

  .discipline-switch__link:hover .discipline-switch__label {
    color: var(--color-ink-soft);
  }

  .discipline-switch__name {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    transition: opacity 0.25s;
  }

  .discipline-switch__link:hover .discipline-switch__name {
    opacity: 0.65;
  }

  .discipline-switch__arrow {
    font-size: 1.125rem;
    color: var(--color-ink-soft);
    transition: transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94), color 0.25s;
  }

  .discipline-switch__link:hover .discipline-switch__arrow {
    transform: translateX(5px);
    color: var(--color-ink);
  }

  /* Phones: the row form ("ALSO EXPLORE  Graphic Design & 3D  →" between two
     rules) is wider than the viewport for long section names, pushing the page
     into horizontal scroll. Stack the label above the name instead. */
  @media (max-width: 560px) {
    .discipline-switch__link {
      flex-direction: column;
      gap: 0.5rem;
      text-align: center;
    }
    .discipline-switch__name { font-size: 1.25rem; }

    /* No room for three things on one line: the lead link takes its own
       row above, and the rules + link keep theirs. */
    .discipline-switch--lead .discipline-switch__inner { flex-wrap: wrap; row-gap: 1.5rem; }
    .discipline-switch--lead .discipline-switch__lead { flex-basis: 100%; }
  }
</style>
